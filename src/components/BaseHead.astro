---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import siteImage from '../assets/生活空間感.png';
import { BRAND_ENGLISH, BRAND_NAME, SITE_DESCRIPTION, SITE_ICON, SITE_TITLE } from '../consts';
interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image } = Astro.props;
const shareImage = image ?? await getImage({ src: siteImage, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const pageTitle = title === SITE_TITLE ? SITE_TITLE : `${title}｜${BRAND_NAME}`;
const siteURL = new URL('/', canonicalURL).href;
const lineURL = 'https://line.me/ti/p/@fer7932k';
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: BRAND_NAME,
  alternateName: BRAND_ENGLISH,
  url: siteURL,
  logo: { '@type': 'ImageObject', url: new URL(SITE_ICON, siteURL).href },
  description: SITE_DESCRIPTION,
  contactPoint: { '@type': 'ContactPoint', contactType: 'customer service', url: lineURL },
  sameAs: [lineURL],
};
---
<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/favicon.ico?v=sprout" sizes="16x16 32x32 48x48" />
<link rel="icon" type="image/png" href={SITE_ICON} sizes="512x512" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />

<!-- ✅ 加在這裡 — Google Fonts (Youthspan 品牌字體) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,400&family=Noto+Serif+TC:wght@300;400&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={pageTitle} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(shareImage.src, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={pageTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(shareImage.src, Astro.url)} />

<script type="application/ld+json" set:html={JSON.stringify(organization)} />
{canonicalURL.pathname === '/' && (
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_TITLE,
    alternateName: [BRAND_NAME, BRAND_ENGLISH],
    url: siteURL,
  })} />
)}

<!-- Google Analytics GA4（真人才記錄）
     機器人進站不到 1 秒就走、不捲動也不點擊，所以 GA4 等到訪客
     「捲動／點擊／觸控／按鍵／移動滑鼠」或停留 8 秒後才載入。
     在那之前的 gtag() 事件先暫存，載入後依序補送，不會漏。
     站長排除自己：網址加 ?ga_off=1（該瀏覽器之後都不記錄），?ga_off=0 恢復。 -->
<script is:inline>
  (function () {
    var ID = 'G-9JPQ34N5BN';
    window.dataLayer = window.dataLayer || [];
    var pending = [];
    var live = false;
    window.gtag = function () { if (live) dataLayer.push(arguments); else pending.push(arguments); };

    try {
      var q = new URLSearchParams(location.search).get('ga_off');
      if (q === '1') localStorage.setItem('ga_off', '1');
      if (q === '0') localStorage.removeItem('ga_off');
      if (localStorage.getItem('ga_off') === '1') return; // 站長本人：完全不載入 GA
    } catch (e) {}

    var EVENTS = ['scroll', 'pointerdown', 'touchstart', 'keydown', 'mousemove', 'wheel'];
    var timer = null;
    function start() {
      if (live) return;
      live = true;
      EVENTS.forEach(function (ev) { removeEventListener(ev, start, true); });
      document.removeEventListener('visibilitychange', arm);
      clearTimeout(timer);
      window.gtag('js', new Date());
      window.gtag('config', ID);
      pending.forEach(function (a) { dataLayer.push(a); });
      pending = [];
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ID;
      document.head.appendChild(s);
    }
    // 只在分頁真的被看著時倒數 8 秒（背景分頁不算）
    function arm() {
      clearTimeout(timer);
      if (document.visibilityState === 'visible') timer = setTimeout(start, 8000);
    }
    EVENTS.forEach(function (ev) { addEventListener(ev, start, { capture: true, passive: true, once: true }); });
    document.addEventListener('visibilitychange', arm);
    arm();
  })();
</script>

  <!-- GA4 CTA 追蹤：軟 / 硬 -->
  <script is:inline>
    document.addEventListener('click', function(e) {
      const link = e.target.closest('a');
      if (!link || !link.href) return;
      const text = (link.innerText || link.textContent || '').trim();
      const page = window.location.pathname;
      if (typeof gtag === 'undefined') return;     // ← 加這一行就好
      // 只送網址本身，不送 ? 後面的內容（LINE 預填訊息裡有讀者填的個資與健康資料）
      const cleanUrl = link.origin + link.pathname;

      // 軟 CTA：LINE 連結
      if (link.href.includes('line.me')) {
        gtag('event', 'cta_click', {
          cta_type: 'soft', cta_name: 'LINE連結',
          link_url: cleanUrl, link_text: text, page_path: page
        });
      }

      // 軟 CTA：身體警報評估
      if (link.href.includes('/assessment')) {
        gtag('event', 'cta_click', {
          cta_type: 'soft', cta_name: '身體警報評估',
          link_url: cleanUrl, link_text: text, page_path: page
        });
      }

      // 硬 CTA：健檢數據填資料
      if (link.href.includes('/prescan')) {
        gtag('event', 'cta_click', {
          cta_type: 'hard', cta_name: '健檢數據填資料',
          link_url: cleanUrl, link_text: text, page_path: page
        });
      }
    });
  </script>
