---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import siteImage from '../assets/生活空間感.png';
import { BRAND_ENGLISH, BRAND_NAME, SITE_DESCRIPTION, SITE_ICON, SITE_TITLE } from '../consts';
interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image } = Astro.props;
const shareImage = image ?? await getImage({ src: siteImage, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const pageTitle = title === SITE_TITLE ? SITE_TITLE : `${title}｜${BRAND_NAME}`;
const siteURL = new URL('/', canonicalURL).href;
const lineURL = 'https://line.me/ti/p/@fer7932k';
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: BRAND_NAME,
  alternateName: BRAND_ENGLISH,
  url: siteURL,
  logo: { '@type': 'ImageObject', url: new URL(SITE_ICON, siteURL).href },
  description: SITE_DESCRIPTION,
  contactPoint: { '@type': 'ContactPoint', contactType: 'customer service', url: lineURL },
  sameAs: [lineURL],
};
---
<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/favicon.ico?v=sprout" sizes="16x16 32x32 48x48" />
<link rel="icon" type="image/png" href={SITE_ICON} sizes="512x512" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />

<!-- ✅ 加在這裡 — Google Fonts (Youthspan 品牌字體) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,400&family=Noto+Serif+TC:wght@300;400&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={pageTitle} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(shareImage.src, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={pageTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(shareImage.src, Astro.url)} />

<script type="application/ld+json" set:html={JSON.stringify(organization)} />
{canonicalURL.pathname === '/' && (
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_TITLE,
    alternateName: [BRAND_NAME, BRAND_ENGLISH],
    url: siteURL,
  })} />
)}

<!-- Google Analytics GA4 -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-9JPQ34N5BN"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  window.gtag = function(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-9JPQ34N5BN');
</script>

  <!-- GA4 CTA 追蹤：軟 / 硬 -->
  <script is:inline>
    document.addEventListener('click', function(e) {
      const link = e.target.closest('a');
      if (!link || !link.href) return;
      const text = (link.innerText || link.textContent || '').trim();
      const page = window.location.pathname;
      if (typeof gtag === 'undefined') return;     // ← 加這一行就好
      // 只送網址本身，不送 ? 後面的內容（LINE 預填訊息裡有讀者填的個資與健康資料）
      const cleanUrl = link.origin + link.pathname;

      // 軟 CTA：LINE 連結
      if (link.href.includes('line.me')) {
        gtag('event', 'cta_click', {
          cta_type: 'soft', cta_name: 'LINE連結',
          link_url: cleanUrl, link_text: text, page_path: page
        });
      }

      // 軟 CTA：身體警報評估
      if (link.href.includes('/assessment')) {
        gtag('event', 'cta_click', {
          cta_type: 'soft', cta_name: '身體警報評估',
          link_url: cleanUrl, link_text: text, page_path: page
        });
      }

      // 硬 CTA：健檢數據填資料
      if (link.href.includes('/prescan')) {
        gtag('event', 'cta_click', {
          cta_type: 'hard', cta_name: '健檢數據填資料',
          link_url: cleanUrl, link_text: text, page_path: page
        });
      }
    });
  </script>
