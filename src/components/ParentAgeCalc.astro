---
// 「你 60 歲時，爸媽幾歲？」小計算器。健康島第一次打開的畫面、示例頁、文字版首頁共用。
// 只在瀏覽器裡算，不送出、不儲存任何年紀（GA4 只記一個「有算」的事件）。
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<div class:list={['pac', { compact }]} data-pac>
  <div class="pac-row">
    <label>你<input type="number" inputmode="numeric" min="18" max="80" placeholder="42" data-me /><span>歲</span></label>
    <label>爸爸<input type="number" inputmode="numeric" min="30" max="110" placeholder="70" data-dad /><span>歲</span></label>
    <label>媽媽<input type="number" inputmode="numeric" min="30" max="110" placeholder="68" data-mom /><span>歲</span></label>
  </div>
  <p class="pac-out" data-out aria-live="polite">填上年紀，看看你 60 歲那年，爸媽幾歲。</p>
</div>

<script>
  const send = () => { try { (window as any).gtag?.('event', 'parent_age_calc'); } catch {} };
  document.querySelectorAll<HTMLElement>('[data-pac]').forEach((box) => {
    const me = box.querySelector<HTMLInputElement>('[data-me]')!;
    const dad = box.querySelector<HTMLInputElement>('[data-dad]')!;
    const mom = box.querySelector<HTMLInputElement>('[data-mom]')!;
    const out = box.querySelector<HTMLElement>('[data-out]')!;
    let sent = false;
    const n = (el: HTMLInputElement) => { const v = Number(el.value); return el.value !== '' && v > 0 && v < 120 ? Math.round(v) : null; };
    const calc = () => {
      const m = n(me), d = n(dad), w = n(mom);
      if (m === null || (d === null && w === null)) { out.textContent = '填上年紀，看看你 60 歲那年，爸媽幾歲。'; out.classList.remove('on'); return; }
      const gap = 60 - m;
      const parts: string[] = [];
      if (d !== null) parts.push(`爸爸 ${d + Math.max(gap, 0)} 歲`);
      if (w !== null) parts.push(`媽媽 ${w + Math.max(gap, 0)} 歲`);
      out.textContent = gap > 0
        ? `你 60 歲時，${parts.join('、')}。到時候扶他們上下車、陪他們看門診的人，很可能是你。那時候，你的身體撐得住嗎？`
        : `現在，${parts.join('、')}。你就是他們最需要的那個人，你的身體，是全家的底盤。`;
      out.classList.add('on');
      if (!sent) { sent = true; send(); }
    };
    [me, dad, mom].forEach((el) => el.addEventListener('input', calc));
  });
</script>

<style>
  .pac { background: #fff7ef; border: 1px solid #f1d9c4; border-radius: 14px; padding: 14px 14px 12px; margin: 10px 0 14px; }
  .pac-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .pac label { display: flex; flex-direction: column; gap: 4px; font-size: 13px; font-weight: 700; color: #3a2a20; position: relative; }
  .pac input { width: 100%; font-family: inherit; font-weight: 700; font-size: 18px; line-height: 1.2; padding: 8px 30px 8px 10px; border: 1px solid #e4cdb8; border-radius: 10px; background: #fff; color: #211d1d; min-height: 42px; -moz-appearance: textfield; }
  .pac input::-webkit-outer-spin-button, .pac input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .pac input:focus { outline: 2px solid #db6a41; outline-offset: 1px; }
  .pac label span { position: absolute; right: 10px; bottom: 11px; font-size: 13px; font-weight: 500; color: #8a7a6e; pointer-events: none; }
  .pac-out { margin: 10px 0 0; font-size: 14px; line-height: 1.6; color: #8a7a6e; }
  .pac-out.on { color: #211d1d; font-weight: 700; }
  .pac.compact { margin: 8px 0 12px; padding: 12px; }
  .pac.compact input { font-size: 16px; }
</style>
