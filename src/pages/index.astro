---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import heroImg from '../assets/生活空間感.png';
import profileImg from '../assets/profile.webp';

const SITE_TITLE = '孫義坤｜給把健康排最後的你——身體重開機計畫';
const SITE_DESCRIPTION = '告別無效的單一補充。用生醫專員的科學實證角度，梳理慢性低度發炎的生活型態風險因子，幫你找回被偷走的體力與清醒。';
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=DM+Mono:wght@300;400&family=Noto+Serif+TC:wght@300;400;500&display=swap" rel="stylesheet" />
    <style>
      :root {
        --teal:       #1a8c82;
        --teal-dark:  #116b63;
        --teal-pale:  rgba(26,140,130,0.07);
        --gold:       #b8935a;
        --gold-pale:  rgba(184,147,90,0.09);
        --ink:        #111820;
        --body:       #3a4a58;
        --muted:      #7a8fa0;
        --border:     rgba(30,70,100,0.09);
        --bg:         #f8f9fb;
        --bg-warm:    #faf8f5;
      }
      * { box-sizing: border-box; }
      body { font-family: 'Noto Serif TC', serif; color: var(--body); background: var(--bg); margin: 0; }

      /* --- HERO --- */
      .hero { padding: 8rem 6vw 6rem; background: var(--ink); color: #fff; position: relative; overflow: hidden; }
      .hero-inner { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; position: relative; z-index: 1; }
      .hero-label { font-family: 'DM Mono', monospace; font-size: 0.95rem; letter-spacing: 0.3em; color: var(--gold); text-transform: uppercase; margin-bottom: 1.5rem; display: block; }
      .hero-title { font-family: 'Cormorant Garamond', serif; font-size: clamp(2.5rem, 4vw, 3.5rem); font-weight: 300; line-height: 1.25; margin-bottom: 2rem; color: #fff; }
      .hero-title em { color: #6de8df; font-style: italic; }
      
      .hero-checklist { list-style: none; padding: 0; margin: 0 0 2.5rem 0; }
      .hero-checklist li { display: flex; flex-direction: column; gap: 0.2rem; padding: 0.95rem 0.8rem 0.95rem 2.4rem; position: relative; border-bottom: 1px solid rgba(255,255,255,0.08); font-weight: 300; }
      .hero-checklist li:last-child { border-bottom: none; }
      .hero-checklist li::before { content: '☑'; color: #6de8df; font-size: 1.2rem; position: absolute; left: 0.5rem; top: 1rem; flex-shrink: 0; }
      .li-main { font-size: 1.15rem; color: #fff; font-weight: 400; line-height: 1.6; }
      .li-sub { font-size: 1.05rem; color: rgba(255,255,255,0.6); line-height: 1.7; font-weight: 300; }

      /* Hero CTA 按鈕組 */
      .hero-cta-group { display: flex; flex-direction: column; gap: 1rem; }
      .btn-primary { display: inline-flex; align-items: center; justify-content: center; padding: 1.2rem 2.5rem; background: var(--teal); color: #fff; text-decoration: none; font-family: 'DM Mono', monospace; font-size: 1.15rem; letter-spacing: 0.15em; border-radius: 2px; transition: all 0.3s; }
      .btn-primary:hover { background: #6de8df; color: var(--ink); transform: translateY(-2px); }
      .btn-secondary { display: inline-flex; align-items: center; justify-content: center; padding: 1rem 2rem; border: 1px solid rgba(255,255,255,0.25); color: rgba(255,255,255,0.8); text-decoration: none; font-family: 'DM Mono', monospace; font-size: 1.05rem; letter-spacing: 0.15em; border-radius: 2px; transition: all 0.3s; }
      .btn-secondary:hover { border-color: rgba(255,255,255,0.8); color: #fff; }

      .hero-image-box { width: 100%; aspect-ratio: 4/5; background: linear-gradient(135deg, rgba(26,140,130,0.1) 0%, rgba(255,255,255,0.05) 100%); border: 1px solid rgba(255,255,255,0.1); border-radius: 2px; display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,0.3); font-family: 'DM Mono', monospace; font-size: 1rem; overflow: hidden; }
      .hero-image-box img { width: 100%; height: 100%; object-fit: cover; }

      /* --- PAIN SECTION --- */
      .pain-section { padding: 6rem 6vw; background: var(--bg-warm); }
      .section-header { text-align: center; max-width: 800px; margin: 0 auto 4rem; }
      .section-label { font-family: 'DM Mono', monospace; font-size: 0.95rem; letter-spacing: 0.3em; color: var(--teal); margin-bottom: 1rem; display: block; }
      .section-title { font-family: 'Cormorant Garamond', serif; font-size: clamp(2.2rem, 4vw, 3rem); color: var(--ink); font-weight: 300; line-height: 1.3; margin: 0 0 1.5rem 0; }
      .section-subtitle { font-size: 1.25rem; line-height: 2; color: var(--body); font-weight: 300; }
      .pain-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; max-width: 1000px; margin: 0 auto; }
      .pain-card { background: #fff; padding: 2.5rem 2rem; border-top: 3px solid var(--gold); box-shadow: 0 10px 30px rgba(0,0,0,0.03); border-radius: 2px; }
      .pain-card h3 { font-size: 1.35rem; color: var(--ink); margin-top: 0; margin-bottom: 0.8rem; }
      .pain-card-tried { font-size: 1rem; color: var(--muted); font-weight: 400; background: var(--bg); padding: 0.6rem 1rem; border-left: 2px solid var(--border); margin-bottom: 1.2rem; line-height: 1.6; font-family: 'DM Mono', monospace; letter-spacing: 0.04em; }
      .pain-card p { font-size: 1.15rem; line-height: 1.8; color: var(--body); margin: 0; font-weight: 300; }

      /* --- SOLUTION / COMPARE --- */
      .solution-section { padding: 6rem 6vw; background: #fff; }
      .solution-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; max-width: 1000px; margin: 0 auto; align-items: start; }
      .compare-box { padding: 2rem; background: var(--bg); border: 1px solid var(--border); border-left: 4px solid var(--muted); margin-bottom: 1.5rem; }
      .compare-box.mine { border-left-color: var(--teal); background: var(--teal-pale); }
      .compare-title { font-size: 1.05rem; letter-spacing: 0.2em; color: var(--muted); margin-bottom: 0.6rem; text-transform: uppercase; font-family: 'DM Mono', monospace;}
      .compare-box.mine .compare-title { color: var(--teal); }
      .compare-text { font-size: 1.2rem; color: var(--ink); font-weight: 400; line-height: 1.7; }

      /* USP 三維框架 */
      .usp-framework { margin-top: 1.5rem; padding: 1.8rem; background: var(--ink); border-radius: 2px; }
      .usp-framework-title { font-family: 'DM Mono', monospace; font-size: 0.9rem; letter-spacing: 0.25em; color: #6de8df; text-transform: uppercase; margin-bottom: 1.2rem; display: block; }
      .usp-row { display: flex; align-items: flex-start; gap: 1rem; padding: 0.8rem 0; border-bottom: 1px solid rgba(255,255,255,0.07); }
      .usp-row:last-child { border-bottom: none; }
      .usp-tag { font-family: 'DM Mono', monospace; font-size: 0.95rem; color: var(--gold); white-space: nowrap; padding-top: 0.15rem; min-width: 6.5rem; }
      .usp-desc { font-size: 1.1rem; color: rgba(255,255,255,0.7); line-height: 1.6; font-weight: 300; }

      /* --- AUTHORITY --- */
      .authority-section { padding: 6rem 6vw; background: var(--bg-warm); }
      .authority-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; max-width: 1000px; margin: 0 auto; align-items: center; }
      .auth-text { font-size: 1.2rem; line-height: 2.1; color: var(--body); font-weight: 300; margin-bottom: 0; }
      .auth-image-box { width: 100%; aspect-ratio: 1; border-radius: 2px; background: var(--gold-pale); border: 1px solid var(--border-gold); display: flex; align-items: center; justify-content: center; color: var(--gold); font-family: 'DM Mono', monospace; font-size: 1rem; overflow: hidden; box-shadow: 8px 8px 0 var(--gold-pale); }
      .auth-image-box img { width: 100%; height: 100%; object-fit: cover; }

      /* --- DELIVERABLE SECTION --- */
      .deliverable-section { padding: 6rem 6vw; background: #fff; }
      .deliverable-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; max-width: 1000px; margin: 0 auto; }
      .deliverable-card { padding: 2rem 1.75rem; border: 1px solid var(--border); border-top: 3px solid var(--teal); border-radius: 2px; background: var(--teal-pale); }
      .deliverable-num { font-family: 'Cormorant Garamond', serif; font-size: 2.8rem; color: var(--teal); font-weight: 300; line-height: 1; margin-bottom: 0.75rem; display: block; }
      .deliverable-title { font-size: 1.25rem; color: var(--ink); font-weight: 500; margin: 0 0 0.8rem 0; }
      .deliverable-desc { font-size: 1.1rem; color: var(--muted); line-height: 1.75; margin: 0; font-weight: 300; }
      .deliverable-note { max-width: 700px; margin: 3.5rem auto 0; text-align: center; font-size: 1.15rem; color: var(--body); line-height: 1.9; font-weight: 300; }

      /* --- FEATURED ARTICLES --- */
      .featured-section { padding: 6rem 6vw; background: var(--bg-warm); }
      .featured-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; max-width: 1000px; margin: 0 auto; }
      .featured-card { display: flex; flex-direction: column; gap: 0.8rem; padding: 2rem 1.75rem; border: 1px solid var(--border); border-top: 3px solid var(--teal); border-radius: 2px; text-decoration: none; color: inherit; transition: box-shadow 0.2s, transform 0.2s; background: #fff; }
      .featured-card:hover { box-shadow: 0 8px 28px rgba(26,140,130,0.10); transform: translateY(-3px); }
      .featured-card-label { font-family: 'DM Mono', monospace; font-size: 0.85rem; letter-spacing: 0.2em; color: var(--teal); text-transform: uppercase; }
      .featured-card-title { font-family: 'Noto Serif TC', serif; font-size: 1.2rem; color: var(--ink); line-height: 1.6; margin: 0; font-weight: 500; }
      .featured-card-desc { font-size: 1.1rem; color: var(--muted); line-height: 1.75; margin: 0; font-weight: 300; flex: 1; }
      .featured-card-cta { font-family: 'DM Mono', monospace; font-size: 0.95rem; color: var(--teal); letter-spacing: 0.1em; margin-top: 0.4rem; }

      /* --- CTA SECTION --- */
      .cta-section { padding: 6rem 6vw; background: var(--ink); color: #fff; text-align: center; }
      .cta-title { font-family: 'Cormorant Garamond', serif; font-size: clamp(2.2rem, 4vw, 3rem); font-weight: 300; margin-bottom: 1.5rem; }
      .cta-sub { font-size: 1.2rem; color: rgba(255,255,255,0.7); margin-bottom: 3rem; font-weight: 300; line-height: 2;}
      .cta-btn-group { display: flex; flex-direction: column; align-items: center; gap: 1.2rem; }
      .cta-divider { font-family: 'DM Mono', monospace; font-size: 0.95rem; color: rgba(255,255,255,0.4); letter-spacing: 0.2em; }

      @media (max-width: 900px) {
        .hero-inner, .solution-grid, .authority-grid { grid-template-columns: 1fr; gap: 3rem; }
        .hero-image-box { aspect-ratio: 16/9; }
        .cta-btn-group { width: 100%; }
        .cta-btn-group .btn-primary, .cta-btn-group .btn-secondary { width: 100%; max-width: 400px; }
      }
    </style>
  </head>
  <body>
    <Header />

    <section class="hero">
      <div class="hero-inner">
        <div>
          <span class="hero-label">生物醫學專員 · 15年醫療研究背景</span>
          <h1 class="hero-title">給<em>把健康排最後</em>的你——<br>身體重開機計畫</h1>
          
          <ul class="hero-checklist">
            <li>
              <span class="li-main">明明睡了 8 小時，一到下午就腦霧</span>
              <span class="li-sub">咖啡只撐一小時，然後又塌下去。腦袋就是轉不動，你自己也知道，但沒辦法。</span>
            </li>
            <li>
              <span class="li-main">B 群吃了、鐵劑試了、朋友推薦的也買了——還是一樣累</span>
              <span class="li-sub">你開始懷疑是不是自己體質的問題，而不是補充品的問題。</span>
            </li>
            <li>
              <span class="li-main">每年體檢都有紅字，醫生說多休息</span>
              <span class="li-sub">出了診間，沒有一件事可以改變。紅字明年還在。</span>
            </li>
            <li>
              <span class="li-main">感冒剛好，嘴破又來；嘴破好了，肩頸又卡住</span>
              <span class="li-sub">不是大病，但從來沒有「完全正常」的狀態，身體一直有事。</span>
            </li>
            <li>
              <span class="li-main">以前可以撐到晚上九點還清醒</span>
              <span class="li-sub">現在下午四點之後，你就在等今天結束。你知道這不對，但不知道從哪裡改。</span>
            </li>
          </ul>

          <div class="hero-cta-group">
            <a href="/prescan" class="btn-primary">📊 我有健檢數據，直接填資料表</a>
            <a href="/assessment" class="btn-secondary">⚡ 先做 1 分鐘身體警報評估</a>
          </div>
        </div>
        
        <div class="hero-image-box">
          <Image src={heroImg} alt="在清晨找回生活餘裕與健康數據" />
        </div>
      </div>
    </section>

    <section class="pain-section" id="pain">
      <div class="section-header">
        <span class="section-label">根本原因</span>
        <h2 class="section-title">以為只是「初老」？<br>其實是你的身體在<em style="font-style:italic;color:var(--teal);">無限期加班</em></h2>
        <p class="section-subtitle">
          很多人看到上面的狀況，都覺得「年紀到了」或是「太累而已」。但從生醫角度來看，這些症狀不是獨立的。研究顯示，這類症狀組合與長期<strong>慢性低度發炎</strong>高度相關。<strong style="color:var(--teal);">幸好，生活型態是可以系統性調整的。</strong>
        </p>
      </div>
      <div class="pain-grid">
        <div class="pain-card">
          <h3>🔋 蓄電力見底</h3>
          <div class="pain-card-tried">你試過：週末狂睡、吃 B 群、換了好幾個品牌</div>
          <p>補不回來——研究指出，慢性低度發炎狀態下，細胞能量代謝效率容易受到影響。補充量不是關鍵，生活型態的整體調整才是。</p>
        </div>
        <div class="pain-card">
          <h3>📊 滿江紅報告</h3>
          <div class="pain-card-tried">你試過：照醫生說多休息，買了保健品吃一堆</div>
          <p>紅字還是在那裡——科學文獻顯示，慢性低度發炎與多項代謝指標異常高度相關。針對單一紅字分開補充，很難同時處理多個面向。</p>
        </div>
        <div class="pain-card">
          <h3>🛡️ 防護網失效</h3>
          <div class="pain-card-tried">你試過：多喝水、看診拿藥、嘴破買口內膏</div>
          <p>好了又來——研究顯示，免疫系統長期過度活化是慢性低度發炎的核心機制之一。修復速度跟不上損耗，才會輪流出現。</p>
        </div>
      </div>
    </section>

    <section class="solution-section">
      <div class="solution-grid">
        <div>
          <span class="section-label">思維轉換</span>
          <h2 class="section-title">為什麼試了這麼多，還是沒用？</h2>
          <p style="margin-top: 1.5rem; line-height: 2; font-weight: 300; font-size: 1.15rem;">因為傳統的方式是「頭痛醫頭」。面對慢性發炎這種全身性的問題，你需要的是把症狀連起來看、找到共同的根本原因，而不是一個症狀配一個保健品。</p>
        </div>
        <div>
          <div class="compare-box">
            <div class="compare-title">傳統做法：無效堆疊</div>
            <div class="compare-text">針對單一症狀盲目吃保健品，治標不治本，最後小毛病還是輪流出現。</div>
          </div>
          <div class="compare-box mine">
            <div class="compare-title">我的做法：三維數據交叉比對</div>
            <div class="compare-text">把三份獨立數據疊在一起，找出最值得優先關注的生活型態調整方向，再決定優先順序。</div>
            <div class="usp-framework">
              <span class="usp-framework-title">數據框架</span>
              <div class="usp-row">
                <span class="usp-tag">血液生化</span>
                <span class="usp-desc">TG／HDL 比值、空腹血糖趨勢、相關發炎指標——對照科學研究文獻，了解這些數字與生活型態的可能關聯</span>
              </div>
              <div class="usp-row">
                <span class="usp-tag">穿戴數據</span>
                <span class="usp-desc">HRV 心率變異、睡眠分期、靜息心率趨勢——反映壓力負荷與睡眠恢復品質的客觀生活型態指標</span>
              </div>
              <div class="usp-row">
                <span class="usp-tag">Prysm iO</span>
                <span class="usp-desc">光學皮膚類胡蘿蔔素掃描——反映抗氧化營養素狀態的參考數值，補充血液數據看不到的面向</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="authority-section">
      <div class="authority-grid">
        <div class="auth-image-box">
           <Image src={profileImg} alt="profile" />
        </div>
        <div>
          <span class="section-label" style="margin-bottom: 1rem;">專業底線</span>
          <h2 class="section-title" style="margin-bottom: 2rem;">我不賣奇蹟，<br>只看科學實證與數據</h2>
          <p class="auth-text">
            國立陽明交通大學應用化學 · 國立清華大學分子醫學背景。
            15 年協助臨床醫師解讀研究數據、撰寫醫學論文——我在醫療體系裡做的，就是把複雜的生醫數據轉化成可以決策的語言。
            <br><br>
            現在我把同樣的方法用在你身上。<strong>帶上你的健檢數據，對照科學研究文獻，了解數字背後可能的生活型態意義。</strong>
          </p>
        </div>
      </div>
    </section>

    <section class="deliverable-section">
      <div class="section-header">
        <span class="section-label">你會拿到什麼</span>
        <h2 class="section-title">完成數據收集後，<br>你將獲得一份<em style="font-style:italic;color:var(--teal);">個人化健康管理參考報告</em></h2>
      </div>
      <div class="deliverable-grid">
        <div class="deliverable-card">
          <span class="deliverable-num">01</span>
          <h3 class="deliverable-title">個人化健康風險提示摘要</h3>
          <p class="deliverable-desc">根據你的三份數據，說明最需要優先關注的健康面向，而不是模糊的「要多休息」。</p>
        </div>
        <div class="deliverable-card">
          <span class="deliverable-num">02</span>
          <h3 class="deliverable-title">90 天生活調整優先建議</h3>
          <p class="deliverable-desc">第一個月該優先調整睡眠作息還是飲食結構？數據決定順序，不是感覺。</p>
        </div>
        <div class="deliverable-card">
          <span class="deliverable-num">03</span>
          <h3 class="deliverable-title">優先調整項目排序</h3>
          <p class="deliverable-desc">你不需要同時改變所有事情。報告告訴你哪一件事先做，其他面向也比較容易跟著改善。</p>
        </div>
        <div class="deliverable-card">
          <span class="deliverable-num">04</span>
          <h3 class="deliverable-title">可追蹤的生活調整方向</h3>
          <p class="deliverable-desc">具體到可以每週追蹤進度，不是貼在冰箱上三天就忘記的「健康建議」。</p>
        </div>
      </div>
      <p class="deliverable-note">
        盲目補充只會浪費時間與金錢。<br>
        先整理你的身體在哪些面向需要優先關注，再決定要從哪裡開始調整。
      </p>
    </section>

    <section class="featured-section">
      <div class="section-header">
        <span class="section-label">先搞懂這三件事</span>
