---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import TagCloud from '../../components/TagCloud.astro';
import { getUrlSlug } from '../../utils/categories';
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---
<!doctype html>
<html lang="zh-TW">
	<head>
		<BaseHead title="慢性發炎 × 抗老化知識庫｜AGELOCKED" description="用生醫專員的科學視角解讀身體訊號、慢性發炎機制與精準健康工具。給把健康排最後的你。" />
		<style>
			.newcomer-banner {
				display: flex;
				align-items: center;
				gap: 1rem;
				flex-wrap: wrap;
				background: rgba(26,140,130,0.07);
				border-left: 3px solid #1a8c82;
				border-radius: 2px;
				padding: 0.9rem 1.4rem;
				margin-bottom: 2rem;
				font-family: 'DM Mono', monospace;
				font-size: 0.8rem;
			}
			.newcomer-label {
				color: #1a8c82;
				font-weight: 600;
				letter-spacing: 0.1em;
				white-space: nowrap;
			}
			.newcomer-text {
				color: #3a4a58;
				flex: 1;
				min-width: 160px;
				letter-spacing: 0.03em;
			}
			.newcomer-cta {
				color: #1a8c82;
				text-decoration: none;
				border-bottom: 1px solid #1a8c82;
				padding-bottom: 1px;
				white-space: nowrap;
				transition: opacity 0.2s;
			}
			.newcomer-cta:hover { opacity: 0.7; }
			main {
				max-width: 960px;
				width: 100%;
				margin: 0 auto;
				padding: 2.5rem 1.5rem 5rem;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 3.5rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1.75rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 1.4rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: var(--ink);
				line-height: 1.3;
				font-family: 'Cormorant Garamond', serif;
				font-size: 1.05rem;
				font-weight: 400;
			}
			.date {
				margin: 0;
				color: var(--muted);
				font-family: 'DM Mono', monospace;
				font-size: 0.68rem;
				letter-spacing: 0.15em;
			}
			ul li a:hover h4 { color: var(--teal); }
			ul li a:hover .date { color: var(--teal); }
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 640px) {
				main {
					padding: 1.5rem 1rem 4rem;
				}
				ul {
					gap: 2rem;
				}
				ul li {
					width: 100%;
					text-align: left;
				}
				ul li:first-child {
					margin-bottom: 0;
					text-align: left;
				}
				ul li:first-child .title {
					font-size: 1.15rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="newcomer-banner">
				<span class="newcomer-label">第一次來？</span>
				<span class="newcomer-text">從這篇開始讀，10 分鐘搞懂你的身體在說什麼</span>
				<a href="/blog/body-signals/three-signs-chronic-inflammation" class="newcomer-cta">帶我去 →</a>
			</div>
			<TagCloud />
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${getUrlSlug(post)}/`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
