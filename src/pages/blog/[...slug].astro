---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { LABEL_TO_SLUG, getUrlSlug } from '../../utils/categories';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: getUrlSlug(post) },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content, headings } = await render(post);

const categorySlug = LABEL_TO_SLUG[post.data.category] ?? null;
const allPosts = await getCollection('blog');
const related = allPosts
	.filter(p => p.id !== post.id && LABEL_TO_SLUG[p.data.category] === categorySlug && categorySlug !== null)
	.sort(() => Math.random() - 0.5)
	.slice(0, 3);
---

<BlogPost {...post.data} headings={headings} relatedPosts={related}>
	<Content />
</BlogPost>
