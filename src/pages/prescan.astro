---
// src/pages/prescan.astro
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = '找回餘裕的掃描前資料表 · AGELOCKED';
const description = '資料越完整，我們越能找出你「理智線容易斷、體力透支」的科學底層原因。有的填、沒有的跳過就好——我們不談玄學，只用數據找回你撐起家庭的能量。';
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead title={title} description={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=DM+Mono:wght@300;400&family=Noto+Serif+TC:wght@300;400;500&display=swap" rel="stylesheet" />
    <style>
      /* 保留原本的 CSS 變數，與您的全站設計系統對齊 */
      :root {
        --teal:    #1a8c82;
        --teal-d:  #116b63;
        --teal-p:  rgba(26,140,130,0.08);
        --gold:    #b8935a;
        --gold-p:  rgba(184,147,90,0.10);
        --ink:     #111820;
        --body:    #3a4a58;
        --muted:   #7a8fa0;
        --border:  rgba(30,70,100,0.10);
        --bg:      #f8f9fb;
        --bg2:     #ffffff;
        --surface: #f0f3f7;
        --red:     #c0392b;
        --red-p:   rgba(192,57,43,0.07);
        --green:   #1a7a50;
        --green-p: rgba(26,122,80,0.07);
        --orange:  #b85c1a;
        --orange-p:rgba(184,92,26,0.07);
      }

      /* ── HEADER 區塊樣式 ── */
      .page-header {
        background: var(--ink);
        padding: 3rem 6vw 2.5rem;
        position: relative; overflow: hidden;
      }
      .page-header::before {
        content: '';
        position: absolute; inset: 0; pointer-events: none;
        background: radial-gradient(ellipse 60% 80% at 80% 50%, rgba(26,140,130,0.12) 0%, transparent 70%);
      }
      .header-inner { max-width: 740px; margin: 0 auto; position: relative;
      }
      .header-brand {
        font-family: 'DM Mono', monospace;
        font-size: 0.62rem; letter-spacing: 0.4em; color: var(--gold);
        text-transform: uppercase; margin-bottom: 1.4rem;
        display: flex; align-items: center; gap: 0.8rem;
      }
      .header-brand::before { content: '◆'; font-size: 0.38rem;
      }
      .page-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(1.9rem, 4vw, 3rem);
        font-weight: 300; color: #fff; line-height: 1.2;
        margin-bottom: 0.8rem;
      }
      .page-title em { font-style: italic; color: #6de8df;
      }
      .page-desc {
        font-size: 0.9rem; color: rgba(255,255,255,0.48);
        font-weight: 300; line-height: 1.9; max-width: 520px;
      }

      /* ── PROGRESS BAR ── */
      .progress-wrap { background: rgba(255,255,255,0.05);
        height: 2px; margin-top: 2rem; }
      .progress-bar {
        height: 100%;
        background: var(--teal);
        width: 0%; transition: width 0.4s ease;
      }

      /* ── FORM BODY ── */
      .form-body { max-width: 740px;
        margin: 0 auto; padding: 3rem 6vw 6rem; background: var(--bg); }

      /* Section */
      .form-section {
        background: var(--bg2);
        border: 1px solid var(--border);
        border-radius: 2px; margin-bottom: 1.6rem;
        overflow: hidden;
        animation: fadeUp 0.5s ease both;
      }
      @keyframes fadeUp {
        from { opacity: 0;
        transform: translateY(12px); }
        to   { opacity: 1; transform: translateY(0);
        }
      }
      .form-section:nth-child(2) { animation-delay: 0.05s;
      }
      .form-section:nth-child(3) { animation-delay: 0.10s; }
      .form-section:nth-child(4) { animation-delay: 0.15s;
      }
      .form-section:nth-child(5) { animation-delay: 0.20s; }
      .form-section:nth-child(6) { animation-delay: 0.25s;
      }

      .section-head {
        padding: 1.4rem 1.8rem 1.2rem;
        border-bottom: 1px solid var(--border);
        display: flex; align-items: flex-start; gap: 1rem;
      }
      .section-num {
        font-family: 'DM Mono', monospace;
        font-size: 0.62rem;
        letter-spacing: 0.2em; color: var(--teal);
        background: var(--teal-p); padding: 0.2rem 0.55rem;
        border-radius: 1px; flex-shrink: 0; margin-top: 0.3rem;
      }
      .section-label-sm {
        font-family: 'DM Mono', monospace;
        font-size: 0.6rem;
        letter-spacing: 0.3em; color: var(--muted); text-transform: uppercase;
        margin-bottom: 0.3rem;
      }
      .section-h {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.2rem; font-weight: 400; color: var(--ink);
      }
      .section-body { padding: 1.6rem 1.8rem;
      }

      /* Fields */
      .field { margin-bottom: 1.3rem;
      }
      .field:last-child { margin-bottom: 0;
      }
      .field-label {
        font-size: 0.82rem; font-weight: 400;
        color: var(--ink);
        margin-bottom: 0.45rem; display: flex; align-items: center; gap: 0.5rem;
      }
      .field-optional {
        font-family: 'DM Mono', monospace;
        font-size: 0.55rem;
        letter-spacing: 0.15em; color: var(--muted);
        background: var(--surface); padding: 0.1rem 0.4rem; border-radius: 1px;
      }
      input[type="text"], input[type="number"], input[type="tel"], select, textarea {
        width: 100%;
        border: 1px solid var(--border);
        border-radius: 2px; padding: 0.7rem 0.9rem;
        font-family: 'Noto Serif TC', serif; font-size: 0.88rem;
        color: var(--ink); background: var(--bg);
        transition: border-color 0.2s, background 0.2s;
        appearance: none;
      }
      input:focus, select:focus, textarea:focus {
        outline: none;
        border-color: var(--teal);
        background: var(--bg2);
      }
      textarea { resize: vertical; min-height: 80px; line-height: 1.8;
      }

      .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem;
      }
      .field-row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.9rem;
      }

      /* Unit label */
      .input-unit { position: relative;
      }
      .input-unit input { padding-right: 3.2rem;
      }
      .unit-tag {
        position: absolute; right: 0.8rem;
        top: 50%; transform: translateY(-50%);
        font-family: 'DM Mono', monospace; font-size: 0.62rem; color: var(--muted);
        pointer-events: none;
      }

      /* Checkbox group */
      .check-grid { display: grid;
        grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-top: 0.2rem; }
      .check-item {
        display: flex;
        align-items: flex-start; gap: 0.6rem;
        padding: 0.7rem 0.9rem; border: 1px solid var(--border);
        border-radius: 2px; cursor: pointer; transition: all 0.15s;
        font-size: 0.83rem;
        color: var(--body); font-weight: 300; line-height: 1.5;
        background: var(--bg);
      }
      .check-item:hover { border-color: var(--teal); background: var(--teal-p);
      }
      .check-item input { flex-shrink: 0; accent-color: var(--teal); margin-top: 0.15rem;
      }

      /* ── TG/HDL CALCULATOR ── */
      .calc-box {
        background: var(--ink);
        border-radius: 2px;
        padding: 1.6rem 1.8rem; margin-top: 1.4rem;
        position: relative; overflow: hidden;
      }
      .calc-box::before {
        content: ''; position: absolute;
        inset: 0; pointer-events: none;
        background: radial-gradient(ellipse 70% 80% at 100% 50%, rgba(26,140,130,0.15) 0%, transparent 70%);
      }
      .calc-label {
        font-family: 'DM Mono', monospace;
        font-size: 0.6rem;
        letter-spacing: 0.3em; color: var(--gold); text-transform: uppercase;
        margin-bottom: 0.8rem; position: relative;
      }
      .calc-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.1rem;
        color: #fff; font-weight: 300; margin-bottom: 1.2rem; position: relative; line-height: 1.5;
      }
      .calc-inputs { display: grid;
        grid-template-columns: 1fr 1fr auto; gap: 0.8rem; align-items: end; position: relative;
      }
      .calc-field label {
        font-size: 0.75rem; color: rgba(255,255,255,0.5);
        display: block; margin-bottom: 0.35rem; font-weight: 300;
      }
      .calc-field input {
        background: rgba(255,255,255,0.07);
        border: 1px solid rgba(255,255,255,0.12);
        color: #fff; font-family: 'DM Mono', monospace; font-size: 1rem;
        padding: 0.65rem 0.8rem; width: 100%; border-radius: 2px;
        transition: border-color 0.2s;
      }
      .calc-field input:focus { outline: none; border-color: var(--teal); background: rgba(26,140,130,0.1);
      }
      .calc-btn {
        padding: 0.65rem 1.2rem; background: var(--teal);
        color: #fff;
        border: none; border-radius: 2px; cursor: pointer;
        font-family: 'DM Mono', monospace; font-size: 0.7rem;
        letter-spacing: 0.15em; text-transform: uppercase;
        transition: background 0.2s; white-space: nowrap;
      }
      .calc-btn:hover { background: var(--teal-d);
      }

      .calc-result {
        margin-top: 1.2rem; padding: 1rem 1.2rem;
        border-radius: 2px; font-size: 0.88rem;
        font-weight: 300; line-height: 1.8; display: none;
        position: relative;
      }
      .calc-result.show { display: block; }
      .calc-result.green { background: rgba(26,122,80,0.15);
        border: 1px solid rgba(26,122,80,0.3); }
      .calc-result.orange { background: rgba(184,92,26,0.15); border: 1px solid rgba(184,92,26,0.3);
      }
      .calc-result.red { background: rgba(192,57,43,0.18); border: 1px solid rgba(192,57,43,0.35);
      }
      .calc-result-ratio {
        font-family: 'Cormorant Garamond', serif;
        font-size: 2rem;
        font-weight: 300; display: block; margin-bottom: 0.4rem;
      }
      .calc-result.green .calc-result-ratio { color: #4ade80;
      }
      .calc-result.orange .calc-result-ratio { color: #fb923c;
      }
      .calc-result.red .calc-result-ratio { color: #f87171;
      }
      .calc-result-text { color: rgba(255,255,255,0.75); font-size: 0.82rem;
      }
      .calc-result-badge {
        font-family: 'DM Mono', monospace;
        font-size: 0.6rem;
        letter-spacing: 0.2em; padding: 0.15rem 0.5rem; border-radius: 1px;
        display: inline-block; margin-bottom: 0.5rem;
      }
      .calc-result.green .calc-result-badge { background: rgba(74,222,128,0.2); color: #4ade80;
      }
      .calc-result.orange .calc-result-badge { background: rgba(251,146,60,0.2); color: #fb923c;
      }
      .calc-result.red .calc-result-badge { background: rgba(248,113,113,0.2); color: #f87171;
      }

      /* ── WATCH DATA SECTION ── */
      .watch-hint {
        background: var(--teal-p);
        border: 1px solid rgba(26,140,130,0.18);
        border-radius: 2px; padding: 1rem 1.2rem;
        font-size: 0.82rem; color: var(--body); font-weight: 300; line-height: 1.85;
        margin-bottom: 1.2rem;
      }
      .watch-hint strong { color: var(--teal); font-weight: 500;
      }
      .watch-guide {
        background: var(--surface); border-radius: 2px;
        padding: 1rem 1.2rem; margin-top: 1rem;
        font-size: 0.78rem; color: var(--muted); font-weight: 300; line-height: 1.9;
      }
      .watch-guide strong { color: var(--ink); font-weight: 500; display: block; margin-bottom: 0.2rem;
      }

      /* ── SUPPLEMENT LIST ── */
      .suppl-row {
        display: grid;
        grid-template-columns: 1fr auto auto;
        gap: 0.6rem; align-items: center; margin-bottom: 0.5rem;
      }
      .suppl-row input { margin-bottom: 0;
      }
      .suppl-add {
        font-family: 'DM Mono', monospace;
        font-size: 0.65rem;
        letter-spacing: 0.15em; color: var(--teal); text-transform: uppercase;
        background: none; border: 1px solid var(--teal); border-radius: 2px;
        padding: 0.45rem 0.8rem;
        cursor: pointer; transition: all 0.2s;
        white-space: nowrap; margin-top: 0.5rem; display: inline-block;
      }
      .suppl-add:hover { background: var(--teal-p);
      }
      .suppl-remove {
        background: none;
        border: 1px solid var(--border); border-radius: 2px;
        padding: 0.45rem 0.6rem; cursor: pointer; color: var(--muted);
        font-size: 0.75rem; transition: all 0.15s; line-height: 1;
      }
      .suppl-remove:hover { border-color: var(--red); color: var(--red);
      }
      .suppl-qty { width: 80px !important;
      }

      /* ── SUBMIT ── */
      .submit-section {
        background: var(--ink);
        border-radius: 2px;
        padding: 2rem 1.8rem; text-align: center;
        position: relative; overflow: hidden;
      }
      .submit-section::before {
        content: ''; position: absolute;
        inset: 0; pointer-events: none;
        background: radial-gradient(ellipse 60% 60% at 50% 50%, rgba(26,140,130,0.12) 0%, transparent 70%);
      }
      .submit-inner { position: relative;
      }
      .submit-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.4rem;
        font-weight: 300; color: #fff; margin-bottom: 0.6rem;
      }
      .submit-sub {
        font-size: 0.8rem;
        color: rgba(255,255,255,0.4);
        font-weight: 300; line-height: 1.9; margin-bottom: 1.6rem;
      }
      .btn-submit {
        display: inline-block;
        background: var(--teal); color: #fff;
        padding: 1rem 3rem; border-radius: 2px; border: none; cursor: pointer;
        font-family: 'DM Mono', monospace; font-size: 0.75rem;
        letter-spacing: 0.2em; text-transform: uppercase;
        transition: all 0.3s; text-decoration: none;
      }
      .btn-submit:hover { background: var(--teal-d);
        transform: translateY(-2px); box-shadow: 0 10px 28px rgba(26,140,130,0.35); }
      .submit-note {
        margin-top: 1.5rem;
        font-family: 'DM Mono', monospace;
        font-size: 0.58rem; letter-spacing: 0.2em; color: rgba(255,255,255,0.22);
      }
      .submit-steps {
        display: flex; flex-direction: column;
        align-items: center; gap: 0.8rem;
        margin-bottom: 0;
      }
      .submit-step {
        display: flex;
        align-items: center; gap: 0.8rem; width: 100%; justify-content: center;
      }
      .step-num {
        font-family: 'DM Mono', monospace;
        font-size: 0.65rem; letter-spacing: 0.15em;
        color: rgba(255,255,255,0.3); flex-shrink: 0;
      }
      .submit-arrow {
        font-size: 1rem;
        color: rgba(255,255,255,0.2);
      }
      .btn-line {
        display: inline-flex;
        align-items: center; justify-content: center; gap: 0.6rem;
        padding: 1rem 2.2rem; border-radius: 2px;
        background: #06C755; color: #ffffff; text-decoration: none;
        font-family: 'DM Mono', monospace; font-size: 0.75rem; letter-spacing: 0.15em;
        text-transform: uppercase; transition: all 0.3s;
      }
      .btn-line:hover { background: #05a847; transform: translateY(-2px); box-shadow: 0 10px 25px rgba(6,199,85,0.35);
      }

      @media (max-width: 600px) {
        .field-row, .field-row-3 { grid-template-columns: 1fr;
        }
        .calc-inputs { grid-template-columns: 1fr 1fr;
        }
        .calc-btn { grid-column: span 2;
        }
        .check-grid { grid-template-columns: 1fr;
        }
        .suppl-row { grid-template-columns: 1fr auto;
        }
        .suppl-qty { display: none;
        }
      }
    </style>
  </head>
  <body>
    <Header />

    <main>
      <header class="page-header">
        <div class="header-inner">
          <div class="header-brand">AGELOCKED · 孫義坤</div>
          <h1 class="page-title">找回餘裕的<em>掃描前資料表</em></h1>
          <p class="page-desc">
            資料越完整，我們越能找出你「理智線容易斷、體力透支」的科學底層原因。有的填、沒有的跳過就好——我們不談玄學，只用數據找回你撐起家庭的能量。
          </p>
          <div class="progress-wrap"><div class="progress-bar" id="progressBar"></div></div>
        </div>
      </header>

      <div class="form-body">
        
        <div class="form-section">
          <div class="section-head">
            <div class="section-num">01</div>
            <div class="section-title-wrap">
    
              <div class="section-label-sm">Basic Info</div>
              <div class="section-h">基本資料</div>
            </div>
          </div>
          <div class="section-body">
            <div class="field-row">
              <div class="field">
            
                <div class="field-label">姓名</div>
                <input type="text" id="name" placeholder="您的稱呼即可" />
              </div>
              <div class="field">
                <div class="field-label">年齡</div>
                <div class="input-unit">
            
                  <input type="number" id="age" placeholder="例如：42" min="20" max="80" />
                  <span class="unit-tag">歲</span>
                </div>
              </div>
            </div>
            <div class="field-row">
              
              <div class="field">
                <div class="field-label">性別</div>
                <select id="gender">
                  <option value="">請選擇</option>
                  <option value="male">男性</option>
                  <option value="female">女性</option>
        
                </select>
              </div>
              <div class="field">
                <div class="field-label">LINE ID <span class="field-optional">選填</span></div>
                <input type="text" id="line_id" placeholder="方便後續追蹤" />
              </div>
         
            </div>
          </div>
        </div>

        <div class="form-section">
          <div class="section-head">
            <div class="section-num">02</div>
            <div class="section-title-wrap">
              <div class="section-label-sm">Blood Lipids</div>
              <div class="section-h">血脂數據（看懂身體的發電效率）</div>
  
            </div>
          </div>
          <div class="section-body">
            <p style="font-size:0.82rem; color:var(--muted); font-weight:300; line-height:1.8; margin-bottom:1.5rem;">
              這不是要看你有沒有生病，而是用來評估你身體「轉換能量的效率」。效率差，當然每天都覺得累。
            </p>
            <div class="field-row-3">
              <div class="field">
                <div class="field-label">三酸甘油酯 TG</div>
                <div class="input-unit">
      
                  <input type="number" id="tg" placeholder="150" step="1" oninput="autoCalc()" />
                  <span class="unit-tag">mg/dL</span>
                </div>
              </div>
              <div class="field">
                <div class="field-label">高密度脂蛋白 
HDL</div>
                <div class="input-unit">
                  <input type="number" id="hdl" placeholder="50" step="1" oninput="autoCalc()" />
                  <span class="unit-tag">mg/dL</span>
                </div>
              </div>
          
              <div class="field">
                <div class="field-label">空腹血糖 <span class="field-optional">選填</span></div>
                <div class="input-unit">
                  <input type="number" id="glucose" placeholder="95" step="1" />
                  <span class="unit-tag">mg/dL</span>
                </div>
 
              </div>
            </div>
            <div class="field-row">
              <div class="field">
                <div class="field-label">HbA1c 糖化血色素 <span class="field-optional">選填</span></div>
                <div class="input-unit">
          
                  <input type="number" id="hba1c" placeholder="5.6" step="0.1" />
                  <span class="unit-tag">%</span>
                </div>
              </div>
              <div class="field">
                <div class="field-label">hs-CRP 高敏 C 反應蛋白 <span class="field-optional">選填</span></div>
 
                <div class="input-unit">
                  <input type="number" id="hsCrp" placeholder="0.8" step="0.1" />
                  <span class="unit-tag">mg/L</span>
                </div>
              </div>
            
            </div>

            <div class="calc-box">
              <div class="calc-label">◆ 即時計算器</div>
              <div class="calc-title">TG / HDL 比值<br><span style="font-size: 0.9rem; color: rgba(255,255,255,0.7);">（找出你下午當機、理智線斷裂的隱藏密碼）</span></div>
              <div class="calc-inputs">
                <div class="calc-field">
                  <label>三酸甘油酯 TG</label>
  
                  <input type="number" id="calc_tg" placeholder="150" oninput="syncCalc()" />
                </div>
                <div class="calc-field">
                  <label>高密度脂蛋白 HDL</label>
                  <input type="number" id="calc_hdl" placeholder="50" oninput="syncCalc()" />
    
                </div>
                <button class="calc-btn" onclick="calculate()">計算</button>
              </div>
              <div class="calc-result" id="calcResult">
                <div class="calc-result-badge" id="calcBadge"></div>
                <span class="calc-result-ratio" id="calcRatio"></span>
    
                <div class="calc-result-text" id="calcText"></div>
              </div>
            </div>

          </div>
        </div>

        <div class="form-section">
          <div class="section-head">
            <div class="section-num">03</div>
         
            <div class="section-title-wrap">
              <div class="section-label-sm">Body Metrics</div>
              <div class="section-h">體態數據</div>
            </div>
          </div>
          <div class="section-body">
            <div class="field-row-3">
              <div class="field">
    
                <div class="field-label">腰圍</div>
                <div class="input-unit">
                  <input type="number" id="waist" placeholder="88" step="0.5" />
                  <span class="unit-tag">cm</span>
                </div>
            
              </div>
