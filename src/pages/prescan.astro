    <script is:inline>
      // ── PROGRESS ──
      function updateProgress() {
        const allInputs = [...document.querySelectorAll('input[type="text"], input[type="number"]:not(#calc_tg):not(#calc_hdl), select, textarea')];
        const totalInputs = allInputs.length;
        const filled = allInputs.filter(el => el.value.trim() !== '' && el.value !== 
          '').length;
        const hasCheck = document.querySelectorAll('input[type="checkbox"]:checked').length > 0 ? 2 : 0;
        const total = totalInputs + 2;
        const pct = Math.min(100, Math.round(((filled + hasCheck) / total) * 100));
        document.getElementById('progressBar').style.width = pct + '%';
      }
      document.addEventListener('input', updateProgress);
      document.addEventListener('change', updateProgress);

      // ── TG/HDL CALCULATOR ──
      function autoCalc() {
  
        const tg = document.getElementById('tg').value;
        const hdl = document.getElementById('hdl').value;
        if (tg) document.getElementById('calc_tg').value = tg;
        if (hdl) document.getElementById('calc_hdl').value = hdl;
        if (tg && hdl) calculate();
      }
      function syncCalc() {
        const tg = document.getElementById('calc_tg').value;
        const hdl = document.getElementById('calc_hdl').value;
        if (tg) document.getElementById('tg').value = tg;
        if (hdl) document.getElementById('hdl').value = hdl;
        if (tg && hdl) calculate();
      }
      function calculate() {
        const tg = parseFloat(document.getElementById('calc_tg').value);
        const hdl = parseFloat(document.getElementById('calc_hdl').value);
        const res = document.getElementById('calcResult');
        const badge = document.getElementById('calcBadge');
        const ratio = document.getElementById('calcRatio');
        const text = document.getElementById('calcText');
        if (!tg || !hdl || hdl === 0) return;

        const val = (tg / hdl).toFixed(2);
        ratio.textContent = val;
        res.className = 'calc-result show';

        // 將回饋文字調整為合規的「能量與營養」用語
        if (val < 2) {
          res.classList.add('green');
          badge.textContent = '發電效率良好';
          text.textContent = `數值 ${val}。你的身體能量轉換效率良好。繼續維持現有習慣，這能讓你保有足夠的耐心面對家庭。`;
        } else if (val < 3.5) {
          res.classList.add('orange');
          badge.textContent = '發電效率正在下滑';
          text.textContent = `數值 ${val}。超過 2 代表身體維持能量的效率正在變差。這往往是下午強烈疲勞、理智線容易斷裂的隱藏生理原因，建議優先調整營養配置。`;
        } else {
          res.classList.add('red');
          badge.textContent = '代謝嚴重過勞';
          text.textContent = `數值 ${val}。超過 3.5 顯示身體代謝已處於過勞狀態，能量嚴重漏電。盲目補充維他命已無太大意義，必須馬上找出源頭進行干預。`;
        }
      }

      // ── SUPPLEMENT LIST ──
      function addSuppl() {
        const list = document.getElementById('supplList');
        const row = document.createElement('div');
        row.className = 'suppl-row';
        row.innerHTML = `
          <input type="text" placeholder="產品名稱（例：LifePak、魚油）" />
          <input type="text" class="suppl-qty" placeholder="每天幾顆" />
          <button class="suppl-remove" onclick="removeSuppl(this)">✕</button>
        `;
        list.appendChild(row);
      }
      function removeSuppl(btn) {
        const rows = document.querySelectorAll('.suppl-row');
        if (rows.length > 1) btn.closest('.suppl-row').remove();
      }

      // ── COPY TO LINE ──
      function copyToLine() {
        const name = document.getElementById('name').value ||
          '（未填）';
        const age = document.getElementById('age').value || '