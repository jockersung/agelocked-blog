---
// src/pages/assessment.astro
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = '身體警報與餘裕流失評估 · AGELOCKED';
const description = '標準健檢找的是疾病，但生活找的是「餘裕」。花 1 分鐘，勾選你觀察到的身體與情緒訊號，找出你理智線容易斷裂的真正原因。';
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead title={title} description={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=DM+Mono:wght@300;400&family=Noto+Serif+TC:wght@300;400;500&display=swap" rel="stylesheet" />
    <style>
      :root {
        --teal:    #1a8c82;
        --teal-d:  #116b63;
        --teal-p:  rgba(26,140,130,0.08);
        --gold:    #b8935a;
        --gold-p:  rgba(184,147,90,0.10);
        --ink:     #111820;
        --body:    #3a4a58;
        --muted:   #7a8fa0;
        --border:  rgba(30,70,100,0.10);
        --bg:      #f8f9fb;
        --bg2:     #ffffff;
        --surface: #f0f3f7;
        --red:     #c0392b;
        --red-p:   rgba(192,57,43,0.07);
        --green:   #1a7a50;
        --green-p: rgba(26,122,80,0.07);
        --orange:  #b85c1a;
        --orange-p:rgba(184,92,26,0.07);
      }

      /* ── HEADER 區塊樣式 ── */
      .page-header {
        background: var(--ink);
        padding: 4rem 6vw 3.5rem;
        position: relative; overflow: hidden;
        text-align: center;
      }
      .page-header::before {
        content: ''; position: absolute;
        inset: 0; pointer-events: none;
        background: radial-gradient(ellipse 60% 80% at 50% 100%, rgba(184,147,90,0.15) 0%, transparent 70%);
      }
      .header-inner { max-width: 680px; margin: 0 auto; position: relative;
      }
      .header-brand {
        font-family: 'DM Mono', monospace;
        font-size: 0.65rem; letter-spacing: 0.4em; 
        color: var(--gold); text-transform: uppercase; margin-bottom: 1.4rem;
        display: flex; align-items: center; justify-content: center; gap: 0.8rem;
      }
      .header-brand::before, .header-brand::after { content: '◆'; font-size: 0.38rem;
      }
      .page-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 300; color: #fff; line-height: 1.3; margin-bottom: 1.2rem;
      }
      .page-title em { font-style: italic; color: #6de8df;
      }
      .page-desc {
        font-size: 0.95rem; color: rgba(255,255,255,0.6);
        font-weight: 300; line-height: 2; max-width: 580px; margin: 0 auto;
      }

      /* ── FORM BODY ── */
      .form-body { max-width: 740px;
        margin: -2rem auto 4rem; padding: 0 6vw; position: relative; z-index: 2;
      }
      
      .quiz-section {
        background: var(--bg2);
        border: 1px solid var(--border);
        border-radius: 2px; margin-bottom: 2rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
      }
      
      .quiz-category { padding: 2rem 2.5rem;
        border-bottom: 1px solid var(--border); }
      .quiz-category:last-child { border-bottom: none;
      }
      
      .cat-head { margin-bottom: 1.5rem;
      }
      .cat-label {
        font-family: 'DM Mono', monospace;
        font-size: 0.65rem; letter-spacing: 0.25em; 
        color: var(--teal); background: var(--teal-p); padding: 0.3rem 0.6rem; 
        border-radius: 1px; display: inline-block; margin-bottom: 0.8rem;
      }
      .cat-title { font-family: 'Cormorant Garamond', serif; font-size: 1.4rem; font-weight: 400; color: var(--ink);
      }

      /* Checkbox Items */
      .check-list { display: flex;
        flex-direction: column; gap: 0.8rem; }
      .check-item {
        display: flex;
        align-items: flex-start; gap: 1rem;
        padding: 1.2rem 1.4rem; border: 1px solid var(--border);
        border-radius: 2px; cursor: pointer; transition: all 0.2s;
        background: var(--bg);
        position: relative; overflow: hidden;
      }
      .check-item:hover { border-color: var(--teal); background: var(--teal-p);
      }
      .check-item.active { border-color: var(--teal); background: var(--bg2); box-shadow: 0 4px 12px rgba(26,140,130,0.08);
      }
      .check-item.active::before {
        content: ''; position: absolute;
        left: 0; top: 0; bottom: 0; width: 3px; background: var(--teal);
      }
      
      .check-item input { flex-shrink: 0; accent-color: var(--teal);
        margin-top: 0.3rem; transform: scale(1.2); cursor: pointer; }
      .check-content { display: flex; flex-direction: column; gap: 0.3rem;
      }
      .check-title { font-size: 0.95rem; font-weight: 500; color: var(--ink);
      }
      .check-desc { font-size: 0.85rem; color: var(--muted); font-weight: 300; line-height: 1.6;
      }

      /* ── RESULT BOX ── */
      .result-box {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 2px; padding: 2.5rem; margin-bottom: 2rem;
        text-align: center; transition: all 0.3s;
      }
      .result-box.hidden { opacity: 0; transform: translateY(20px); pointer-events: none; display: none;
      }
      .result-box.show { opacity: 1; transform: translateY(0); display: block; animation: fadeUp 0.5s ease;
      }
      
      .score-display {
        font-family: 'Cormorant Garamond', serif;
        font-size: 3.5rem; 
        font-weight: 300; color: var(--ink); margin-bottom: 0.5rem; line-height: 1;
      }
      .score-display span { font-size: 1.5rem; color: var(--muted);
      }
      
      .result-badge {
        font-family: 'DM Mono', monospace;
        font-size: 0.75rem; letter-spacing: 0.15em;
        padding: 0.4rem 1rem; border-radius: 2px; display: inline-block; margin-bottom: 1.2rem;
      }
      .result-box.green .result-badge { background: rgba(26,122,80,0.15); color: var(--green);
      }
      .result-box.orange .result-badge { background: rgba(184,92,26,0.15); color: var(--orange);
      }
      .result-box.red .result-badge { background: rgba(192,57,43,0.12); color: var(--red);
      }
      
      .result-text { font-size: 0.95rem; color: var(--body); font-weight: 300;
        line-height: 1.9; max-width: 560px; margin: 0 auto; }
      .result-text strong { color: var(--ink); font-weight: 500;
      }

      /* ── SUBMIT SECTION ── */
      .submit-section {
        background: var(--ink);
        border-radius: 2px; padding: 2.5rem 2rem; text-align: center;
        position: relative; overflow: hidden;
      }
      .submit-section::before {
        content: ''; position: absolute;
        inset: 0; pointer-events: none;
        background: radial-gradient(ellipse 50% 50% at 50% 50%, rgba(26,140,130,0.15) 0%, transparent 70%);
      }
      .submit-inner { position: relative; z-index: 1;
      }
      .submit-title { font-family: 'Cormorant Garamond', serif; font-size: 1.5rem; font-weight: 300; color: #fff; margin-bottom: 0.8rem;
      }
      .submit-sub { font-size: 0.85rem; color: rgba(255,255,255,0.6); font-weight: 300; line-height: 1.8; margin-bottom: 1.8rem;
      }
      
      .btn-submit {
        display: inline-block;
        background: var(--teal); color: #fff;
        padding: 1.1rem 3rem; border-radius: 2px; border: none; cursor: pointer;
        font-family: 'DM Mono', monospace; font-size: 0.8rem;
        letter-spacing: 0.2em; 
        text-transform: uppercase; transition: all 0.3s;
      }
      .btn-submit:hover { background: var(--teal-d); transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(26,140,130,0.35); }
      .btn-submit:disabled { background: var(--muted); cursor: not-allowed; opacity: 0.5;
        box-shadow: none; transform: none; }

      .next-step-box {
        margin-top: 1.8rem;
        padding: 1.4rem 1.6rem;
        background: var(--ink); border-radius: 2px;
        border-left: 3px solid var(--gold);
      }
      .next-step-text {
        font-size: 0.88rem; line-height: 1.9;
        color: rgba(255,255,255,0.7);
        font-weight: 300; margin: 0 0 1.1rem 0;
      }
      .next-step-text strong { color: #ffffff;
        font-weight: 500; }
      .next-step-btn {
        display: inline-block;
        padding: 0.85rem 1.6rem;
        background: var(--gold); color: #ffffff; text-decoration: none;
        font-family: 'DM Mono', monospace; font-size: 0.78rem;
        letter-spacing: 0.12em; border-radius: 2px;
        transition: all 0.25s;
      }
      .next-step-btn:hover { background: #9a7848; transform: translateY(-2px); box-shadow: 0 8px 20px rgba(184,147,90,0.3);
      }

      .submit-steps {
        display: flex; flex-direction: column;
        align-items: center; gap: 0.8rem;
      }
      .submit-step {
        display: flex;
        align-items: center; gap: 0.8rem; width: 100%; justify-content: center;
      }
      .step-num {
        font-family: 'DM Mono', monospace;
        font-size: 0.65rem; letter-spacing: 0.15em;
        color: rgba(255,255,255,0.3); flex-shrink: 0;
      }
      .submit-arrow {
        font-size: 1rem;
        color: rgba(255,255,255,0.2);
      }
      .btn-line {
        display: inline-flex;
        align-items: center; justify-content: center; gap: 0.6rem;
        padding: 1.1rem 2.2rem; border-radius: 2px;
        background: #06C755; color: #ffffff; text-decoration: none;
        font-family: 'DM Mono', monospace; font-size: 0.8rem; letter-spacing: 0.15em;
        text-transform: uppercase; transition: all 0.3s;
      }
      .btn-line:hover { background: #05a847; transform: translateY(-2px); box-shadow: 0 10px 25px rgba(6,199,85,0.35);
      }
      
      @keyframes fadeUp {
        from { opacity: 0;
        transform: translateY(15px); }
        to   { opacity: 1; transform: translateY(0);
        }
      }

      @media (max-width: 600px) {
        .page-header { padding: 3rem 5vw 2.5rem;
        }
        .quiz-category { padding: 1.5rem;
        }
        .check-item { padding: 1rem;
        }
        .result-box { padding: 1.5rem;
        }
      }
    </style>
  </head>
  <body>
    <Header />

    <main>
      <header class="page-header">
        <div class="header-inner">
          <div class="header-brand">AGELOCKED · 專屬評估</div>
          <h1 class="page-title">身體警報與餘裕流失<br><em>自我評估清單</em></h1>
          <p class="page-desc">
            標準健檢找的是「疾病」，但生活更需要的是「餘裕」。花 1 分鐘，勾選你過去 3 個月內頻繁出現的真實狀況，幫你找出理智線容易斷裂、體能斷層的底層原因。
          </p>
        </div>
      </header>

      <div class="form-body">
        
        <div class="quiz-section">
          
          <div class="quiz-category">
            <div class="cat-head">
              <div class="cat-label">PART 01</div>
              <h2 class="cat-title">情緒與理智線</h2>
            </div>
            <div class="check-list">
              <label class="check-item">
                <input type="checkbox" name="alarm" value="理智線極薄" onchange="toggleActive(this)">
                <div class="check-content">
                  <div class="check-title">理智線極薄</div>
                  <div class="check-desc">下班回到家，看到小孩鬧或碗沒洗，理智線比以前更容易瞬間斷掉，事後又覺得後悔。</div>
                </div>
              </label>
              <label class="check-item">
                <input type="checkbox" name="alarm" value="社交與伴侶失聯" onchange="toggleActive(this)">
                <div class="check-content">
                  <div class="check-title">社交與伴侶失聯</div>
                  <div class="check-desc">下班後只剩下「滑手機放空」的力氣，連跟另一半好好說話、關心彼此都覺得好累。</div>
                </div>
              </label>
              <label class="check-item">
                <input type="checkbox" name="alarm" value="神經煞車失靈" onchange="toggleActive(this)">
                <div class="check-content">
                  <div class="check-title">神經煞車失靈</div>
                  <div class="check-desc">晚上躺在床上腦袋一直轉工作或小孩的事，明明身體已經很累，卻無法進入深層休息。</div>
                </div>
              </label>
            </div>
          </div>

          <div class="quiz-category">
            <div class="cat-head">
              <div class="cat-label">PART 02</div>
              <h2 class="cat-title">體力與續航力</h2>
            </div>
            <div class="check-list">
              <label class="check-item">
                <input type="checkbox" name="alarm" value="體能斷層感" onchange="toggleActive(this)">
                <div class="check-content">
                  <div class="check-title">體能斷層感</div>
                  <div class="check-desc">以前熬夜隔天還能上班，現在光是蹲下來撿東西、陪小孩玩樂高，都覺得身體吃力。</div>
                </div>
              </label>
              <label class="check-item">
                <input type="checkbox" name="alarm" value="無效的補眠" onchange="toggleActive(this)">
                <div class="check-content">
                  <div class="check-title">無效的補眠</div>
                  <div class="check-desc">週末盡量睡滿 8 小時甚至補眠，但禮拜一早上起床身體依然沉重，感覺根本沒充到電。</div>
                </div>
              </label>
              <label class="check-item">
                <input type="checkbox" name="alarm" value="下午強制當機" onchange="toggleActive(this)">
                <div class="check-content">
                  <div class="check-title">下午強制當機</div>
                  <div class="check-desc">下午 2-4 點之間會出現明顯的「腦霧」，只能靠猛灌咖啡因硬撐過接下來的會議。</div>
                </div>
              </label>
            </div>
          </div>

          <div class="quiz-category">
            <div class="cat-head">
              <div class="cat-label">PART 03</div>
              <h2 class="cat-title">代謝與修復力</h2>
            </div>
            <div class="check-list">
              <label class="check-item">
                <input type="checkbox" name="alarm" value="修復期嚴重拉長" onchange="toggleActive(this)">
                <div class="check-content">
                  <div class="check-title">修復期嚴重拉長</div>
                  <div class="check-desc">不管是偶爾運動的痠痛，還是生了一場小感冒，現在需要的「恢復天數」比以前長非常多。</div>
                </div>
              </label>
              <label class="check-item">
                <input type="checkbox" name="alarm" value="防護網破洞" onchange="toggleActive(this)">
                <div class="check-content">
                  <div class="check-title">防護網破洞</div>
                  <div class="check-desc">只要生活壓力一來，就覺得嘴破、肩頸僵硬，或者各種小毛病開始輪流出現找麻煩。</div>
                </div>
              </label>
              <label class="check-item">
                <input type="checkbox" name="alarm" value="頑固的腰圍" onchange="toggleActive(this)">
                <div class="check-content">
                  <div class="check-title">頑固的腰圍</div>
                  <div class="check-desc">飲食沒變、也沒吃得比較多，但這兩年腹部脂肪越來越難減，看著體態變差卻無能為力。</div>
                </div>
              </label>
            </div>
          </div>

        </div>

        <div id="resultBox" class="result-box hidden">
          <div class="score-display"><span id="scoreNum">0</span> <span>/ 9</span></div>
         
          <div id="resultBadge" class="result-badge">測量中</div>
          <div id="resultText" class="result-text">請勾選上方符合的狀況以顯示評估結果。</div>
          <div id="nextStepBox" class="next-step-box" style="display:none;">
            <p class="next-step-text">
              這份評估是第一步——它顯示了你目前流失了多少<strong>生活餘裕</strong>。<br>
              要知道該從哪裡補救，我們需要把這個結果和你的「健檢數據」與「穿戴裝置」放在一起比對。
            </p>
            <a href="/prescan" class="next-step-btn">📊 下一步：填寫掃描前資料，找出科學解法</a>
          </div>
        </div>

        <div class="submit-section">
          <div class="submit-inner">
            <div class="submit-title">獲取專屬解析</div>
            <p class="submit-sub">
              先複製你的評估結果，再開啟 LINE 貼上傳送給我。<br>
              我會根據你的勾選項目，協助你整理出能最快找回體力與情緒空間的起點。
            </p>
            <div class="submit-steps">
              <div class="submit-step">
                <span class="step-num">1</span>
                <button class="btn-submit" id="copyBtn" onclick="copyResult()" disabled>📋 複製評估結果</button>
              </div>
              <div class="submit-arrow">↓</div>
   
              <div class="submit-step">
                <span class="step-num">2</span>
                <a href="https://line.me/ti/p/@fer7932k" target="_blank" rel="noopener" class="btn-line">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink:0">
                    <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
                  </svg>
                  開啟 LINE 傳送結果
                </a>
              </div>
            </div>
          </div>
        </div>
        
        <div style="font-size: 0.75rem;
          color: var(--muted); margin-top: 1.5rem; text-align: center; font-weight: 300;">
          免責聲明：本表單為自我評估工具，不具備醫療診斷之功效。若有明確疾病請就醫。
        </div>

      </div>
    </main>

    <Footer />

    <script is:inline>
      // 點擊選項時切換樣式與計算分數
      function toggleActive(checkbox) {
        const label = checkbox.closest('.check-item');
        if (checkbox.checked) {
          label.classList.add('active');
        } 
        else {
          label.classList.remove('active');
        }
        calculateScore();
      }

      function calculateScore() {
        const checkedBoxes = document.querySelectorAll('input[name="alarm"]:checked');
        const score = checkedBoxes.length;
        const resultBox = document.getElementById('resultBox');
        const scoreNum = document.getElementById('scoreNum');
        const badge = document.getElementById('resultBadge');
        const text = document.getElementById('resultText');
        const copyBtn = document.getElementById('copyBtn');

        scoreNum.textContent = score;

        if (score === 0) {
          resultBox.className = 'result-box hidden';
          copyBtn.disabled = true;
          document.getElementById('nextStepBox').style.display = 'none';
          return;
        }

        copyBtn.disabled = false;
        resultBox.className = 'result-box show';
        document.getElementById('nextStepBox').style.display = 'block';

        if (score <= 2) {
          resultBox.classList.add('green');
          badge.textContent = '生活餘裕尚存';
          text.innerHTML = '你目前觀察到的警報不多，代表你的身體還有足夠的能量應付日常的消耗。請繼續保持目前的習慣，並注意壓力調節，這將是你陪伴家人最好的資本。';
        } else if (score <= 5) {
          resultBox.classList.add('orange');
          badge.textContent = '健康技術債累積中';
          text.innerHTML = '你可能會自責最近常常對家人沒耐心，但這其實是<strong>身體能量見底的訊號</strong>。慢性低度發炎正在吃掉你的生活餘裕。此時盲目吞維他命效果有限，你需要的是針對生活型態的科學盤點。';
        } else {
          resultBox.classList.add('red');
          badge.textContent = '嚴重透支警報';
          text.innerHTML = '你真的辛苦了。這不是你脾氣不好或是做錯了什麼，而是你的身體已經處於<strong>無限期加班</strong>的耗竭狀態。強烈建議停止盲目測試保健品，先帶上你的健檢數據，我們從科學的角度把漏電的地方找出來。';
        }
      }

      function copyResult() {
        const checkedBoxes = document.querySelectorAll('input[name="alarm"]:checked');
        const score = checkedBoxes.length;

        const signals = Array.from(checkedBoxes).map(cb => `- ${cb.value}`).join('\n');
        let status = '';
        if (score <= 2) status = '🟢 生活餘裕尚存';
        else if (score <= 5) status = '🟡 健康技術債累積中';
        else status = '🔴 嚴重透支警報';

        const textToCopy = `【AGELOCKED 身體警報與餘裕評估】\n\n我的評估分數：${score} / 9\n整體狀況：${status}\n\n▌我目前面臨的狀況：\n${signals}\n\n（孫站長，這是我目前的評估結果，希望能了解如何找回生活餘裕。）`;
        
        navigator.clipboard.writeText(textToCopy).then(() => {
          const btn = document.getElementById('copyBtn');
          btn.textContent = '✓ 已複製！請開啟 LINE 貼上';
          btn.style.background = '#1a7a50';
          setTimeout(() => {
            btn.textContent = '📋 複製評估結果並傳送';
            btn.style.background = '';
          }, 3500);
      
        }).catch(() => {
          const ta = document.createElement('textarea');
          ta.value = textToCopy; ta.style.position = 'fixed'; ta.style.opacity = '0';
          document.body.appendChild(ta); ta.select(); document.execCommand('copy');
          document.body.removeChild(ta);
          alert('已複製！請開啟 LINE 貼上傳送給我。');
        });
      }
    </script>
  </body>
</html>