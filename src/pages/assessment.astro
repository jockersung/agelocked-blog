---
// src/pages/assessment.astro
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = '身體警報訊號評估清單 · AGELOCKED';
const description = '40 歲是一個分水嶺。花 1 分鐘，勾選過去 3 個月常出現的狀況，看看身材、臉蛋、性健康、禿頭白髮、心血管、睡眠與恢復，哪幾站正在亮燈。';

// 男性慢老六站版的身體警報訊號。性健康那一組只在瀏覽器裡計算，不放進傳到 LINE 的訊息（個資法特種個資）。
const PARTS = [
  { st: 'body', name: '身材', items: [
    ['腰圍悄悄變大', '吃的跟以前差不多，近一兩年褲子卻越穿越緊，肚子的肉越來越難減。'],
    ['肌肉和衝勁流失', '力量在下降，體態開始變鬆，做事的衝勁也跟著少了。'],
    ['壓力性進食', '壓力一大，就特別想吃甜的、重口味或宵夜。'] ] },
  { st: 'face', name: '臉蛋', items: [
    ['臉上長斑', '顴骨、額頭的斑變多、變深，拍照越來越明顯。'],
    ['看起來比實際累', '明明有睡，照片裡還是顯得疲倦、氣色差，同事會問你是不是很累。'] ] },
  { st: 'sexual-health', name: '性健康', private: true, items: [
    ['晨間反應變少', '早上醒來的自然反應，比以前少很多。'],
    ['硬度或持久度不如以前', '以前不必想的事，現在開始在意。'],
    ['性慾變低', '沒有那麼想了，不確定是太累還是別的原因。'] ] },
  { st: 'hair', name: '禿頭、白髮', items: [
    ['頭頂或髮際線變薄', '拍照會刻意找角度，或洗頭時掉髮明顯變多。'],
    ['白髮增加得很快', '一兩年內白髮明顯變多，比同齡朋友早。'] ] },
  { st: 'heart', name: '心血管', items: [
    ['爬樓梯會喘', '爬兩三層樓就喘，以前不會。'],
    ['報告上有紅字還沒處理', '血脂、血糖或血壓被標示超出範圍，但一直沒有回診追蹤。'],
    ['家人有心臟病或中風', '父母或兄弟姊妹有心臟病、中風，或很年輕就開始吃心血管的藥。'] ] },
  { st: 'checkup', name: '睡眠與恢復', items: [
    ['睡滿還是累', '週末就算補眠，週一早上起床身體依然很沉重。'],
    ['下午續航力斷崖', '下午兩到四點腦袋像起霧，要靠咖啡才撐得過會議。'],
    ['晚上腦袋停不下來', '躺在床上還在想工作，很難睡沉。'],
    ['恢復期拉長', '運動後的痠痛、熬夜的疲勞、小感冒，都要比以前多好幾天才好。'] ] },
];
const TOTAL = PARTS.reduce((n, p) => n + p.items.length, 0);
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead title={title} description={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=DM+Mono:wght@300;400&family=Noto+Serif+TC:wght@300;400;500&display=swap" rel="stylesheet" />
    <style>
      :root {
        --teal:    #1a8c82;
        --teal-d:  #116b63;
        --teal-p:  rgba(26,140,130,0.08);
        --gold:    #b8935a;
        --gold-p:  rgba(184,147,90,0.10);
        --ink:     #111820;
        --body:    #3a4a58;
        --muted:   #7a8fa0;
        --border:  rgba(30,70,100,0.10);
        --bg:      #f8f9fb;
        --bg2:     #ffffff;
        --surface: #f0f3f7;
        --red:     #c0392b;
        --red-p:   rgba(192,57,43,0.07);
        --green:   #1a7a50;
        --green-p: rgba(26,122,80,0.07);
        --orange:  #b85c1a;
        --orange-p:rgba(184,92,26,0.07);
      }

      * { box-sizing: border-box; }

      /* ── HEADER 區塊樣式 ── */
      .page-header {
        background: var(--ink);
        padding: 4rem 6vw 3.5rem;
        position: relative; overflow: hidden;
        text-align: center;
      }
      .page-header::before {
        content: ''; position: absolute;
        inset: 0; pointer-events: none;
        background: radial-gradient(ellipse 60% 80% at 50% 100%, rgba(184,147,90,0.15) 0%, transparent 70%);
      }
      .header-inner { max-width: 680px; margin: 0 auto; position: relative; }
      .header-brand {
        font-family: 'DM Mono', monospace;
        font-size: 0.85rem; letter-spacing: 0.4em; 
        color: var(--gold); text-transform: uppercase; margin-bottom: 1.4rem;
        display: flex; align-items: center; justify-content: center; gap: 0.8rem;
      }
      .header-brand::before, .header-brand::after { content: '◆'; font-size: 0.5rem; }
      .page-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(2.2rem, 4vw, 3.2rem);
        font-weight: 300; color: #fff; line-height: 1.3; margin-bottom: 1.2rem;
      }
      .page-title em { font-style: italic; color: #6de8df; }
      .page-desc {
        font-size: 1.2rem; color: rgba(255,255,255,0.7);
        font-weight: 300; line-height: 2; max-width: 580px; margin: 0 auto;
      }

      /* ── FORM BODY ── */
      .form-body { max-width: 740px; margin: -2rem auto 4rem; padding: 0 6vw; position: relative; z-index: 2; }
      
      .quiz-section {
        background: var(--bg2);
        border: 1px solid var(--border);
        border-radius: 2px; margin-bottom: 2rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
      }
      
      .quiz-category { padding: 2rem 2.5rem; border-bottom: 1px solid var(--border); }
      .quiz-category:last-child { border-bottom: none; }
      
      .cat-head { margin-bottom: 1.5rem; }
      .cat-label {
        font-family: 'DM Mono', monospace;
        font-size: 0.85rem; letter-spacing: 0.25em; 
        color: var(--teal); background: var(--teal-p); padding: 0.3rem 0.6rem; 
        border-radius: 1px; display: inline-block; margin-bottom: 0.8rem;
      }
      .cat-title { font-family: 'Cormorant Garamond', serif; font-size: 1.6rem; font-weight: 400; color: var(--ink); margin: 0;}

      /* Checkbox Items */
      .check-list { display: flex; flex-direction: column; gap: 0.8rem; }
      .check-item {
        display: flex;
        align-items: flex-start; gap: 1rem;
        padding: 1.2rem 1.4rem; border: 1px solid var(--border);
        border-radius: 2px; cursor: pointer; transition: all 0.2s;
        background: var(--bg);
        position: relative; overflow: hidden;
      }
      .check-item:hover { border-color: var(--teal); background: var(--teal-p); }
      .check-item.active { border-color: var(--teal); background: var(--bg2); box-shadow: 0 4px 12px rgba(26,140,130,0.08); }
      .check-item.active::before {
        content: ''; position: absolute;
        left: 0; top: 0; bottom: 0; width: 3px; background: var(--teal);
      }
      
      .check-item input { flex-shrink: 0; accent-color: var(--teal); margin-top: 0.3rem; transform: scale(1.4); cursor: pointer; }
      .check-content { display: flex; flex-direction: column; gap: 0.4rem; }
      .check-title { font-size: 1.25rem; font-weight: 500; color: var(--ink); }
      .check-desc { font-size: 1.1rem; color: var(--muted); font-weight: 300; line-height: 1.6; }
      .cat-lock { font-size: .95rem; color: var(--muted); font-weight: 300; margin: .4rem 0 0; }
      .st-bars { display: flex; flex-wrap: wrap; justify-content: center; gap: .4rem; margin: .4rem 0 1rem; }
      /* 下面這些元素由 JavaScript 動態產生，要用 :global 才套得到樣式 */
      .st-bars :global(span) { font-size: .95rem; color: var(--muted); border: 1px solid var(--border); border-radius: 999px; padding: .25rem .7rem; display: inline-flex; gap: .4rem; align-items: center; }
      .st-bars :global(span b) { font-family: 'DM Mono', monospace; font-weight: 400; }
      .st-bars :global(span.on) { color: var(--ink); border-color: var(--teal); background: var(--teal-p); }
      .part-insight-text :global(strong) { color: #fff; font-weight: 500; }
      .part-insight-text :global(a) { color: #5fd3c8; font-weight: 500; }
      .next-step-text a { color: #5fd3c8; font-weight: 500; }
      .result-text :global(strong) { color: var(--ink); }

      /* ── RESULT BOX ── */
      .result-box {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 2px; padding: 2.5rem; margin-bottom: 2rem;
        text-align: center; transition: all 0.3s;
      }
      .result-box.hidden { opacity: 0; transform: translateY(20px); pointer-events: none; display: none; }
      .result-box.show { opacity: 1; transform: translateY(0); display: block; animation: fadeUp 0.5s ease; }
      
      .score-display {
        font-family: 'Cormorant Garamond', serif;
        font-size: 3.5rem; 
        font-weight: 300; color: var(--ink); margin-bottom: 0.5rem; line-height: 1;
      }
      .score-display span { font-size: 1.5rem; color: var(--muted); }
      
      .result-badge {
        font-family: 'DM Mono', monospace;
        font-size: 0.95rem; letter-spacing: 0.15em;
        padding: 0.4rem 1rem; border-radius: 2px; display: inline-block; margin-bottom: 1.2rem;
      }
      .result-box.green .result-badge { background: rgba(26,122,80,0.15); color: var(--green); }
      .result-box.orange .result-badge { background: rgba(184,92,26,0.15); color: var(--orange); }
      .result-box.red .result-badge { background: rgba(192,57,43,0.12); color: var(--red); }
      
      .result-text { font-size: 1.2rem; color: var(--body); font-weight: 300; line-height: 1.9; max-width: 540px; margin: 0 auto; }
      .result-text strong { color: var(--ink); font-weight: 500; }

      /* ── SUBMIT SECTION ── */
      .submit-section {
        background: var(--ink);
        border-radius: 2px; padding: 2.5rem 2rem; text-align: center;
        position: relative; overflow: hidden;
      }
      .submit-section::before {
        content: ''; position: absolute;
        inset: 0; pointer-events: none;
        background: radial-gradient(ellipse 50% 50% at 50% 50%, rgba(26,140,130,0.15) 0%, transparent 70%);
      }
      .submit-inner { position: relative; z-index: 1; }
      .submit-title { font-family: 'Cormorant Garamond', serif; font-size: 1.8rem; font-weight: 300; color: #fff; margin-bottom: 0.8rem; }
      .submit-sub { font-size: 1.1rem; color: rgba(255,255,255,0.7); font-weight: 300; line-height: 1.8; margin-bottom: 1.8rem; }
      
      .btn-submit {
        display: block;
        width: 100%;
        background: var(--teal); color: #fff;
        padding: 1.2rem 3rem; border-radius: 2px; border: none; cursor: pointer;
        font-family: 'DM Mono', monospace; font-size: 1.1rem;
        letter-spacing: 0.2em; 
        text-transform: uppercase; transition: all 0.3s;
        text-align: center;
      }
      .btn-submit:hover { background: var(--teal-d); transform: translateY(-2px); box-shadow: 0 10px 25px rgba(26,140,130,0.35); }
      .btn-submit:disabled { background: var(--muted); cursor: not-allowed; opacity: 0.5; box-shadow: none; transform: none; }

      .next-step-box {
        margin-top: 1.8rem;
        padding: 1.4rem 1.6rem;
        background: var(--ink); border-radius: 2px;
        border-left: 3px solid var(--gold);
      }
      .next-step-text {
        font-size: 1.1rem; line-height: 1.9;
        color: rgba(255,255,255,0.7);
        font-weight: 300; margin: 0 0 1.1rem 0;
      }
      .next-step-text strong { color: #ffffff; font-weight: 500; }
      .next-step-btn {
        display: inline-block;
        padding: 0.85rem 1.6rem;
        background: var(--gold); color: #ffffff; text-decoration: none;
        font-family: 'DM Mono', monospace; font-size: 1.05rem;
        letter-spacing: 0.12em; border-radius: 2px;
        transition: all 0.25s;
      }
      .next-step-btn:hover { background: #9a7848; transform: translateY(-2px); box-shadow: 0 8px 20px rgba(184,147,90,0.3); }

      .submit-steps { display: flex; flex-direction: column; align-items: center; gap: 0.8rem; }
      .submit-step { display: flex; align-items: center; gap: 0.8rem; width: 100%; justify-content: center; }
      .step-num {
        font-family: 'DM Mono', monospace;
        font-size: 0.9rem; letter-spacing: 0.15em;
        color: rgba(255,255,255,0.3); flex-shrink: 0;
      }
      .submit-arrow { font-size: 1.2rem; color: rgba(255,255,255,0.2); }
      .btn-line {
        display: flex;
        width: 100%;
        align-items: center; justify-content: center; gap: 0.6rem;
        padding: 1.1rem 2.2rem; border-radius: 2px;
        background: #06C755; color: #ffffff; text-decoration: none;
        font-family: 'DM Mono', monospace; font-size: 1.05rem; letter-spacing: 0.15em;
        text-transform: uppercase; transition: all 0.3s;
      }
      .btn-line:hover { background: #05a847; transform: translateY(-2px); box-shadow: 0 10px 25px rgba(6,199,85,0.35); }
      
      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(15px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      /* ── PART INSIGHT BLOCK ── */
      .part-insight {
        margin-top: 1.6rem;
        padding: 1.3rem 1.5rem;
        background: var(--ink);
        border-left: 3px solid var(--gold);
        border-radius: 2px;
        text-align: left;
      }
      .part-insight-label {
        font-family: 'DM Mono', monospace;
        font-size: 0.8rem; letter-spacing: 0.25em;
        color: var(--gold); text-transform: uppercase;
        margin-bottom: 0.6rem;
      }
      .part-insight-text {
        font-size: 1.05rem; color: rgba(255,255,255,0.75);
        font-weight: 300; line-height: 1.85;
      }
      .part-insight-text strong { color: #ffffff; font-weight: 500; }

      @media (max-width: 600px) {
        .page-header { padding: 3rem 5vw 2.5rem; }
        .quiz-category { padding: 1.5rem; }
        .check-item { padding: 1rem; }
        .result-box { padding: 1.5rem; }
      }
    </style>
  </head>
  <body>
    <Header />

    <main>
      <header class="page-header">
        <div class="header-inner">
          <div class="header-brand">AGELOCKED · 男性慢老</div>
          <h1 class="page-title">身體警報訊號<br><em>自我評估清單</em></h1>
          <p class="page-desc">
            40 歲是一個分水嶺。健檢找的是已經發生的疾病，但身體在出狀況之前，常常先在外表、體力和日常感受上亮燈。花 1 分鐘，勾選過去 3 個月常出現的狀況，看看你的身體在六站裡，哪幾站正在亮燈。
          </p>
        </div>
      </header>

      <div class="form-body">
        
        <div class="quiz-section">
          {PARTS.map((p, k) => (
            <div class="quiz-category" data-st={p.st} data-name={p.name}>
              <div class="cat-head">
                <div class="cat-label">PART {String(k + 1).padStart(2, '0')}</div>
                <h2 class="cat-title">{p.name}</h2>
                {p.private && <p class="cat-lock">🔒 這一組只在你的手機上計算，不會放進傳給我的訊息；見面時想談再談。</p>}
              </div>
              <div class="check-list">
                {p.items.map(([t, d]) => (
                  <label class="check-item">
                    <input type="checkbox" name="alarm" value={t} data-private={p.private ? '1' : undefined} onchange="toggleActive(this)" />
                    <div class="check-content">
                      <div class="check-title">{t}</div>
                      <div class="check-desc">{d}</div>
                    </div>
                  </label>
                ))}
              </div>
            </div>
          ))}
        </div>

        <div id="resultBox" class="result-box hidden">
          <div class="score-display"><span id="scoreNum">0</span> <span>/ {TOTAL}</span></div>
          <div id="stationBars" class="st-bars"></div>
         
          <div id="resultBadge" class="result-badge">測量中</div>
          <div id="resultText" class="result-text">請勾選上方符合的狀況以顯示評估結果。</div>
          <div id="partInsight" class="part-insight" style="display:none;">
            <div class="part-insight-label">◆ 你亮燈最多的一站</div>
            <div id="partInsightText" class="part-insight-text"></div>
          </div>
          <div id="nextStepBox" class="next-step-box" style="display:none;">
            <p class="next-step-text">
              這份清單是第一步，它顯示的是你自己觀察到的變化。<br>
              下一步，把你手上的健檢報告、手錶紀錄放進來，我幫你做一份<strong>男性慢老起點整理</strong>：先記錄什麼、哪些問題帶給醫師。
            </p>
            <a href="/prescan/" class="next-step-btn">📊 下一步：填寫掃描前資料表</a>
            <p class="next-step-text" style="margin-top:1rem"><a href="/sample/">先看一份起點整理示例 →</a></p>
          </div>
        </div>

        <div class="submit-section">
          <div class="submit-inner">
            <div class="submit-title">取得個人化方向</div>
            <p class="submit-sub">
              按第 2 步會直接開啟 LINE，結果已經填在對話框，按傳送就完成。<br>
              如果對話框是空的，先按第 1 步複製，再貼上傳送。我會告訴你最值得先處理的是哪一站。
            </p>
            <div class="submit-steps">
              <div class="submit-step">
                <span class="step-num">1</span>
                <button class="btn-submit" id="copyBtn" onclick="copyResult()" disabled>📋 複製評估結果</button>
              </div>
              <div class="submit-arrow">↓</div>
              <div class="submit-step">
                <span class="step-num">2</span>
                <a id="lineBtn" href="https://line.me/R/ti/p/%40fer7932k" target="_blank" rel="noopener" class="btn-line">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink:0">
                    <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
                  </svg>
                  開啟 LINE 傳送結果
                </a>
              </div>
            </div>
          </div>
        </div>
        
        <div style="font-size: 0.95rem; color: var(--muted); margin-top: 1.5rem; text-align: center; font-weight: 300;">
          免責聲明：本表單為自我評估工具，不具備醫療診斷之功效。若有明確疾病請就醫。
        </div>

      </div>
    </main>

    <Footer />

    <script is:inline>
      // ── 六站各自的下一步（不做診斷；什麼情況看哪一科） ──
      const ST = {
        'body': { text: '你的訊號集中在<strong>身材</strong>：腰圍、體力和飲食。先每週同一天量一次腰圍，再把健檢報告上的血脂、血糖找出來，這兩樣是身材變化最常一起看的數字。', cat: 'body' },
        'face': { text: '你的訊號集中在<strong>臉蛋</strong>：斑點和氣色。日曬和睡眠是最常見的兩個因素，出門前擦防曬，並在固定光線下拍一張不開美肌的照片當起點。如果有一塊斑短時間變大、顏色不均、會癢或流血，盡快看皮膚科。', cat: 'face' },
        'sexual-health': { text: '你的訊號集中在<strong>性健康</strong>。先分清楚是太累、沒有慾望，還是勃起本身有變化；這類變化有時和血管、血糖、睡眠有關。反覆困擾，帶著紀錄找泌尿科醫師最直接。', cat: 'sexual-health' },
        'hair': { text: '你的訊號集中在<strong>禿頭、白髮</strong>。先在固定位置、同一盞燈下拍頭頂和髮際線，也想想家人的掉髮狀況。頭髮變化慢，3 個月比一次才準；想了解處理方式，看皮膚科。', cat: 'hair' },
        'heart': { text: '你的訊號集中在<strong>心血管</strong>。先用「722」量法量一週居家血壓（連續 7 天、早晚各一次、每次兩遍），帶著報告和家族史找家醫科或心臟內科。<br><strong>如果有胸痛、胸悶、呼吸困難，或突然單側無力、說話不清楚，請立即就醫。</strong>', cat: 'heart' },
        'checkup': { text: '你的訊號集中在<strong>睡眠與恢復</strong>。睡不飽、下午沒電、恢復變慢，常常是壓力、睡眠和代謝一起造成的。先固定上床時間一週，手錶有睡眠或 HRV 紀錄的話，把近一個月的趨勢截圖留著。', cat: 'checkup' },
      };

      function stationCounts() {
        return [...document.querySelectorAll('.quiz-category')].map(cat => ({
          st: cat.dataset.st, name: cat.dataset.name,
          n: cat.querySelectorAll('input[name="alarm"]:checked').length,
          total: cat.querySelectorAll('input[name="alarm"]').length,
        }));
      }
      function topStation() {
        const c = stationCounts().filter(x => x.n > 0);
        c.sort((a, b) => b.n / b.total - a.n / a.total || b.n - a.n);
        return c[0] || null;
      }

      function updatePartInsight(score) {
        const insightBox = document.getElementById('partInsight');
        const insightText = document.getElementById('partInsightText');
        const bars = document.getElementById('stationBars');
        if (score === 0) { insightBox.style.display = 'none'; bars.innerHTML = ''; return; }
        bars.innerHTML = stationCounts().map(x => `<span class="${x.n ? 'on' : ''}">${x.name}<b>${x.n}</b></span>`).join('');
        const top = topStation();
        insightText.innerHTML = ST[top.st].text + `<br><a href="/knowledge/?cat=${ST[top.st].cat}">看「${top.name}」這一站的文章 →</a>`;
        insightBox.style.display = 'block';
      }

      function toggleActive(checkbox) {
        const label = checkbox.closest('.check-item');
        label.classList.toggle('active', checkbox.checked);
        calculateScore();
      }

      function calculateScore() {
        const checkedBoxes = document.querySelectorAll('input[name="alarm"]:checked');
        const score = checkedBoxes.length;
        const total = document.querySelectorAll('input[name="alarm"]').length;
        const resultBox = document.getElementById('resultBox');
        const badge = document.getElementById('resultBadge');
        const text = document.getElementById('resultText');
        const copyBtn = document.getElementById('copyBtn');
        document.getElementById('scoreNum').textContent = score;

        if (score === 0) {
          resultBox.className = 'result-box hidden';
          copyBtn.disabled = true;
          document.getElementById('nextStepBox').style.display = 'none';
          updatePartInsight(0);
          updateLine();
          return;
        }
        copyBtn.disabled = false;
        resultBox.className = 'result-box show';
        document.getElementById('nextStepBox').style.display = 'block';
        const lit = stationCounts().filter(x => x.n > 0).length;

        if (score <= 2) {
          resultBox.classList.add('green');
          badge.textContent = '目前亮燈不多';
          text.innerHTML = '你勾的狀況不多，身體大致還跟得上。這正是最適合開始記錄的時候：趁變化還小，先留下自己的起點數字，之後才比得出差別。';
        } else if (score <= 6) {
          resultBox.classList.add('orange');
          badge.textContent = `有 ${lit} 站開始亮燈`;
          text.innerHTML = '你的健檢報告可能還很漂亮，但外表、體力或日常感受已經在提醒你。這個階段最有效的，不是再多買一罐保健品，而是先弄清楚該從哪一站開始，把變化記錄下來。';
        } else {
          resultBox.classList.add('red');
          badge.textContent = `${lit} 站同時亮燈`;
          text.innerHTML = '你勾的狀況不少，好幾站同時在亮燈。不用一次處理全部：先挑你最在意的一站，把資料整理清楚，報告上有紅字或身體有明顯不適的，先找醫師評估。';
        }
        updatePartInsight(score);
        updateLine();
      }

      // ── 要傳到 LINE 的文字（第一行維持原本格式；性健康的勾選不放進來） ──
      function buildText() {
        // 只算可以分享的勾選（不含性健康），訊息裡的項數才不會透露有沒勾的部分
        const checked = [...document.querySelectorAll('input[name="alarm"]:checked')].filter(cb => !cb.dataset.private);
        const score = checked.length;
        let status = score <= 2 ? '🟢 目前亮燈不多' : score <= 6 ? '🟡 有幾站開始亮燈' : '🔴 多站同時亮燈';
        const groups = {};
        checked.forEach(cb => { if (cb.dataset.private) return; const n = cb.closest('.quiz-category').dataset.name; (groups[n] = groups[n] || []).push(cb.value); });
        const lines = Object.entries(groups).map(([n, v]) => `${n}：${v.join('、')}`).join('\n') || '（沒有可分享的勾選）';
        const pub = stationCounts().filter(x => x.n > 0 && x.st !== 'sexual-health').sort((a, b) => b.n / b.total - a.n / a.total || b.n - a.n)[0];
        const topLine = pub ? `\n亮燈最多：${pub.name}` : '';
        return `【AGELOCKED 身體警報評估結果】\n\n我勾了 ${score} 項\n整體狀況：${status}${topLine}\n\n▌我目前觀察到的變化：\n${lines}\n\n請幫我看，我現在最該先處理哪一站。`;
      }
      function updateLine() {
        const btn = document.getElementById('lineBtn');
        if (!document.querySelectorAll('input[name="alarm"]:checked').length) { btn.href = 'https://line.me/R/ti/p/%40fer7932k'; return; }
        btn.href = 'https://line.me/R/oaMessage/%40fer7932k/?' + encodeURIComponent(buildText());
      }

      function copyResult() {
        const textToCopy = buildText();
        navigator.clipboard.writeText(textToCopy).then(() => {
          const btn = document.getElementById('copyBtn');
          btn.textContent = '✓ 已複製！請開啟 LINE 貼上傳送';
          btn.style.background = '#1a7a50';
          setTimeout(() => { btn.textContent = '📋 複製評估結果'; btn.style.background = ''; }, 3500);
        }).catch(() => {
          const ta = document.createElement('textarea');
          ta.value = textToCopy; ta.style.position = 'fixed'; ta.style.opacity = '0';
          document.body.appendChild(ta); ta.select(); document.execCommand('copy');
          document.body.removeChild(ta);
          alert('已複製！請開啟 LINE 貼上傳送給我。');
        });
      }
    </script>
  </body>
</html>
