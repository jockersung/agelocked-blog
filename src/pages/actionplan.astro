          '開始記錄深睡比例作為第三個月的對比基準'
        ],
        p3t:'延伸評估', p3i:[
          '第 8 週重新評估三個維度的主觀感受變化',
          '若腰圍仍在觀察區間，可評估加入 ageLOC Meta',
          '安排新一次健檢，追蹤 TG/HDL 比值變化'
        ]
      },
      cortisol:{
        pp:'皮質醇 ／ 睡眠修復維度 · 觀察訊號最強',
        p1t:'睡眠修復窗口優先', p1i:[
          'MYND360 舒眠膠囊（睡前）：穩定皮質醇節律，改善深睡比例',
          '此階段暫不加入 R2——睡眠品質未改善前，粒線體自噬效率仍受限',
          '觀察重點：HRV 趨勢、深睡比例（目標 ≥15%）、早晨清醒感'
        ],
        p2t:'睡眠改善後加入 R2', p2i:[
          '第 3–4 週若 HRV 有回升趨勢，開始加入 ageLOC R2 日錠',
          '睡眠修復窗口改善後，R2 夜錠的粒線體自噬效果才能充分運作',
          '持續追蹤 HRV 與深睡比例，確認兩者同步改善'
        ],
        p3t:'完整組合評估', p3i:[
          '第 2 個月確認 R2 日夜錠 + MYND360 的整體效果',
          '視腰圍與 TG/HDL 數值，評估是否加入 Meta',
          '第 90 天重新填寫本問卷，對比三個維度評分變化'
        ]
      },
      testosterone:{
        pp:'睪固酮 ／ 內臟脂肪維度 · 觀察訊號最強',
        p1t:'代謝迴路多點介入', p1i:[
          'ageLOC R2 日錠（早餐後）：Nrf2 路徑支援整體細胞抗氧化防禦基礎',
          'ageLOC Meta 每代紫（隨餐）：三重多酚針對內臟脂肪三條路徑同時切入',
          '配合每週 ≥3 次 Zone 2 有氧（兒茶素 COMT 機制需要運動刺激才能充分發揮）'
        ],
        p2t:'加入夜間修復模組', p2i:[
          '第 4 週加入 R2 夜錠，支援夜間睪固酮分泌窗口（深睡期）與粒線體更新',
          '若睡眠品質仍差，評估加入 MYND360（皮質醇是睪固酮的直接拮抗因素）',
          '記錄第一次 4 週腰圍數據作為 Meta 效果的客觀基準'
        ],
        p3t:'數字驗證與調整', p3i:[
          '第 8 週對比腰圍、HRV、晨勃頻率三項的變化',
          '若 TG/HDL 有改善，Meta 繼續維持；若無變化，確認運動頻率是否達標',
          '視情況安排第二次 Prysm iO 掃描，對比細胞抗氧化指數'
        ]
      }
    };

    // ── TRACKING ──
    const tracking = {
      mito:[
        {m:'靜止心率 RHR',t:'目標：回到或低於個人基準線',h:'Apple Watch → 健康 → 心臟 → 靜止心率 → 截圖「過去一個月」趨勢圖'},
        {m:'HRV 心率變異度',t:'目標：趨勢穩定或緩步上升',h:'Apple Watch → 健康 → 心率變異度 → 過去一個月平均'},
        {m:'下午能量感受',t:'目標：下午 2–3 點不再系統性昏沉',h:'每天給自己打分 1–10，記錄在備忘錄，看週平均有無上升'},
        {m:'運動後恢復時間',t:'目標：同強度運動的酸痛/疲勞恢復縮短',h:'Garmin / Apple Watch 的「恢復時間」數值，或主觀記錄'}
      ],
      cortisol:[
        {m:'深睡比例',t:'目標：≥ 15%（Apple Watch 深層睡眠）',h:'健康 App → 睡眠 → 深層睡眠，看每週平均比例'},
        {m:'HRV 心率變異度',t:'目標：回升至個人歷史基準線以上',h:'健康 App → 心率變異度 → 查看一個月趨勢，關注方向而非單日數值'},
        {m:'早晨清醒感',t:'目標：起床後 15 分鐘內感覺清醒',h:'每天起床後 10 分鐘主觀評估，記錄 1–10 分'},
        {m:'靜止心率 RHR',t:'目標：不再緩步上升，趨勢趨於穩定',h:'Apple Watch → 靜止心率 → 看月趨勢圖的走向'}
      ],
      testosterone:[
        {m:'腰圍',t:'目標：4 週縮減 1–2 cm（量測條件需一致）',h:'早晨空腹、站立、肚臍水平量，每次相同條件，記錄數字'},
        {m:'TG/HDL 比值',t:'目標：下次健檢時比值下降',h:'需要新一次抽血，拿到報告後重新在掃描前問卷計算'},
        {m:'晨勃頻率',t:'目標：4 週內頻率有回升',h:'每週記錄次數（0–7），觀察趨勢，不需精確到天'},
        {m:'Prysm iO 分數',t:'目標：3 個月後重新掃描對比基準',h:'預約第二次掃描，數值差異是 R2 + Meta 效果的客觀驗證'}
      ]
    };

    // ── GENERATE ──
    function generate(){
      const sc = score();
      document.getElementById('output').style.display = 'block';
      setTimeout(()=>document.getElementById('output').scrollIntoView({behavior:'smooth',block:'start'}),120);

      const pl = plans[sc.p];
      document.getElementById('ppText').textContent = pl.pp;

      // Bars
      setTimeout(()=>{
        document.getElementById('sA').textContent = sc.A+' 分';
        document.getElementById('sB').textContent = sc.B+' 分';
        document.getElementById('sC').textContent = sc.C+' 分';
        document.getElementById('bA').style.width = sc.Ap+'%';
        document.getElementById('bB').style.width = sc.Bp+'%';
        document.getElementById('bC').style.width = sc.Cp+'%';
      },200);

      // Data cards
      const tg=g('tg'), hdl=g('hdl'), waist=g('waist'), rhr=g('rhr'), hrv=g('hrv'), prysm=g('prysm');
      const ratio=sc.ratio;

      // Health check
      let hcR='', hcT='未填入血脂數值', hcC='badge-ok', hcB='—';
      if(tg&&hdl){
        hcT=`TG: ${tg} mg/dL\nHDL: ${hdl} mg/dL\nTG/HDL: ${ratio.toFixed(2)}`;
        if(waist) hcT+=`\n腰圍: ${waist} cm`;
        if(ratio>3.5){hcB='文獻觀察：次臨床代謝風險閾值（>3.5）';hcC='badge-red';}
        else if(ratio>2){hcB='文獻觀察：值得關注區間（2–3.5）';hcC='badge-warn';}
        else{hcB='文獻觀察：一般參考範圍（<2）';}
      }
      document.getElementById('dHC').textContent=hcT;
      document.getElementById('bHC').textContent=hcB;
      document.getElementById('bHC').className='d-badge '+hcC;

      // Watch
      let wT='未填入穿戴數據', wC='badge-ok', wB='建議填入以提升分析精準度';
      if(rhr||hrv){
        wT=(rhr?`RHR: ${rhr} bpm\n`:'')+(hrv?`HRV: ${hrv} ms\n`:'');
        if(gs('rhr_trend')==='up') wT+='RHR 近期：緩步上升';
        if(hrv&&hrv<25){wB='文獻觀察：HRV 低於常見警示區間';wC='badge-red';}
        else if(hrv&&hrv<35){wB='文獻觀察：HRV 偏低觀察範圍';wC='badge-warn';}
        else if(rhr&&rhr>70){wB='文獻觀察：RHR 偏高，底層負擔訊號';wC='badge-warn';}
        else{wB='文獻觀察：在一般參考範圍內，持續追蹤趨勢';}
      }
      document.getElementById('dW').textContent=wT;
      document.getElementById('bW').textContent=wB;
      document.getElementById('bW').className='d-badge '+wC;

      // Prysm
      let pT='尚未進行掃描', pC='badge-ok', pB='可預約掃描後填入，補充細胞層級數據';
      if(prysm){
        pT=`掃描分數: ${prysm.toLocaleString()}`;
        if(prysm<20000){pB='文獻對照：細胞抗氧化儲備偏低區間';pC='badge-red';}
        else if(prysm<35000){pB='文獻對照：一般觀察區間，有提升空間';pC='badge-warn';}
        else{pB='文獻對照：在較佳觀察區間';}
      }
      document.getElementById('dP').textContent=pT;
      document.getElementById('bP').textContent=pB;
      document.getElementById('bP').className='d-badge '+pC;

      // Analysis
      document.getElementById('analysisBody').innerHTML = analysis[sc.p](sc);

      // Timeline
      [['p1t','p1i',pl.p1t,pl.p1i,'tl-m1'],['p2t','p2i',pl.p2t,pl.p2i,'tl-m2'],['p3t','p3i',pl.p3t,pl.p3i,'tl-m3']]
        .forEach(([ti,ii,tt,items,cls])=>{
          document.getElementById(ti).textContent=tt;
          document.getElementById(ii).innerHTML=items.map(item=>
            `<div class="tl-item"><div class="tl-dot ${cls}"></div><span>${item}</span></div>`
          ).join('');
        });

      // Tracking
      document.getElementById('trackGrid').innerHTML = tracking[sc.p].map(m=>
        `<div class="track-card">
          <div class="track-metric">${m.m}</div>
          <div class="track-target">${m.t}</div>
          <div class="track-how">${m.h}</div>
        </div>`
      ).join('');

      document.getElementById('progressFill').style.width='100%';
    }
    </script>
  </body>
</html>
