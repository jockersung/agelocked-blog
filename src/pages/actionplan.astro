    <script is:inline>
    // ── UTILS ──
    const g = id => parseFloat(document.getElementById(id).value) || 0;
    const gs = id => document.getElementById(id).value;
    const syms = () => [...document.querySelectorAll('#symGrid input:checked')].map(e=>e.value);
    function tog(el){ el.closest('.chk').classList.toggle('on', el.checked); }
    function prog(){
      const filled = ['tg','hdl','waist','rhr','hrv'].filter(id=>document.getElementById(id).value).length;
      const chks = Math.min(syms().length, 3);
      document.getElementById('progressFill').style.width = Math.min(100, Math.round((filled+chks)/8*100))+'%';
    }

    // ── SCORING ──
    function score(){
      const tg=g('tg'), hdl=g('hdl'), waist=g('waist');
      const rhr=g('rhr'), hrv=g('hrv'), ds=g('deepsleep');
      const trend=gs('rhr_trend'), ss=syms();
      let A=0,B=0,C=0;
      const ratio=(tg&&hdl)?tg/hdl:null;
      if(ratio){ if(ratio>3.5)C+=3; else if(ratio>2)C+=2; }
      if(waist){ if(waist>=95)C+=3; else if(waist>=90)C+=2; else if(waist>=85)C+=1; }
      if(rhr){ if(rhr>72)A+=3; else if(rhr>68)A+=2; else if(rhr>65)A+=1; }
      if(trend==='up')A+=2;
      if(hrv){ if(hrv<25)B+=3; else if(hrv<35)B+=2; else if(hrv<45)B+=1; }
      if(ds){ if(ds<10)B+=3; else if(ds<15)B+=2; else if(ds<20)B+=1; }
      const sm={fatigue_pm:{A:2},sleep_tired:{A:2,B:1},brain_fog:{A:1,B:1},recovery_slow:{A:2},
                belly_up:{C:2},libido_down:{C:2},morning_erect:{C:3},stress_high:{B:2},
                sleep_poor:{B:2},muscle_loss:{C:1,A:1}};
      ss.forEach(s=>{ const w=sm[s]||{}; A+=w.A||0; B+=w.B||0; C+=w.C||0; });
      const mx=Math.max(A,B,C,1);
      const p = A>=B&&A>=C?'mito': B>=A&&B>=C?'cortisol':'testosterone';
      return {A,B,C,Ap:Math.round(A/mx*100),Bp:Math.round(B/mx*100),Cp:Math.round(C/mx*100),ratio,p};
    }

    // ── DETAILED ANALYSIS TEXT ──
    const analysis = {
      mito(sc){
        const rhr=g('rhr'), hrv=g('hrv'), trend=gs('rhr_trend'), ss=syms();
        let html='';
        html+=`<p>你的數字組合在文獻中與<strong>粒線體能量代謝效率下降</strong>的觀察訊號最為吻合。`;
        if(rhr>65||trend==='up'){
          html+=`靜止心率${rhr?`（${rhr} bpm）`:''}${trend==='up'?'近期緩步上升，':''}在研究中與細胞能量輸出下降、身體底層維持成本升高有關聯——當粒線體效率降低，心臟需要更多次收縮來維持相同的組織灌流。`;
        }
        if(hrv&&hrv<45){
          html+=`心率變異度（HRV ${hrv} ms）落在${hrv<25?'低於常見警示':'偏低觀察'}區間，研究顯示此區間的副交感神經活性偏低，身體在夜間進入深層修復模式的效率受限，是「睡了還是累」的常見生理背景。`;
        }
        if(ss.includes('fatigue_pm')||ss.includes('recovery_slow')){
          html+=`<br><br>你勾選的症狀（${[ss.includes('fatigue_pm')?'下午疲勞':null, ss.includes('recovery_slow')?'運動恢復慢':null].filter(Boolean).join('、')}）與文獻描述的粒線體 ATP 輸出不足表現一致。這類疲勞的特徵是<strong>系統性、下午更明顯、與運動量不成比例</strong>，有別於單純睡眠不足造成的疲倦。`;
        }
        html+=`</p><p>ageLOC R2 的設計針對此維度的核心機制——日錠啟動 Nrf2 轉錄因子，上調細胞內源性抗氧化酵素（SOD、GSH）；夜錠支援夜間粒線體自噬（受損粒線體的清除更新）與肝臟 Phase II 解毒窗口。這不是補充外來的抗氧化劑，而是讓細胞自身的修復系統重新上線。</p>`;
        return html;
      },
      cortisol(sc){
        const hrv=g('hrv'), ds=g('deepsleep'), ss=syms();
        let html='';
        html+=`<p>你的數字組合在文獻中與<strong>皮質醇節律紊亂 / 副交感神經修復效率下降</strong>的觀察訊號最為吻合。`;
        if(hrv&&hrv<45){
          html+=`HRV（${hrv} ms）偏低是此維度最直接的客觀指標——它反映的是自律神經「油門（交感）與煞車（副交感）」切換的靈活度。數值偏低代表身體長期處於交感神經主導的備戰狀態，副交感神經的修復窗口被壓縮。`;
        }
        if(ds&&ds<20){
          html+=`深睡比例（${ds}%）低於文獻建議的 15–20% 參考範圍，深睡階段是睪固酮脈衝式分泌、粒線體自噬、以及皮質醇歸零的主要時間窗口——這個窗口利用率不足，其他維度的介入效果都會受到限制。`;
        }
        if(ss.includes('stress_high')||ss.includes('sleep_poor')){
          html+=`<br><br>你勾選的症狀（${[ss.includes('stress_high')?'壓力難放鬆':null, ss.includes('sleep_poor')?'睡眠淺易醒':null].filter(Boolean).join('、')}）在文獻中與 HPA 軸（下視丘—垂體—腎上腺）過度活化有關聯，是皮質醇節律長期偏移的主要表現。`;
        }
        html+=`</p><p><strong>為什麼要先處理這個維度？</strong>皮質醇偏高是睪固酮的直接拮抗因素（兩者共享同一前驅物），也會削弱 Oligonol® 的產熱效應。在這個維度未穩定之前，貿然加入其他保健成分，效果容易被部分抵消。MYND360 舒眠膠囊針對睡眠修復窗口設計，是此維度的優先選項。</p>`;
        return html;
      },
      testosterone(sc){
        const ratio=sc.ratio, waist=g('waist'), ss=syms();
        let html='';
        html+=`<p>你的數字組合在文獻中與<strong>睪固酮下滑 × 內臟脂肪累積的雙向惡性迴路</strong>的觀察訊號最為吻合。`;
        if(ratio){
          html+=`TG/HDL 比值（${ratio.toFixed(2)}）${ratio>3.5?'超過文獻定義的次臨床代謝風險閾值（3.5）':'落在值得關注的觀察區間（>2）'}，研究顯示此數值與胰島素敏感性下降、內臟脂肪累積的族群分佈高度重疊。`;
        }
        if(waist>=85){
          html+=`腰圍（${waist} cm）${waist>=90?'達到台灣代謝症候群定義的觀察閾值（男性 ≥ 90 cm）':'在代謝風險觀察範圍內（85–89 cm）'}。內臟脂肪（非皮下脂肪）是活躍的內分泌器官，持續分泌 IL-6、TNF-α 等促炎細胞因子，並透過芳香酶（CYP19A1）將睪固酮轉化為雌激素，形成「脂肪越多→睪固酮越低→脂肪更多」的自我強化迴路。`;
        }
        if(ss.includes('morning_erect')||ss.includes('libido_down')){
          html+=`<br><br>你勾選的症狀（${[ss.includes('morning_erect')?'晨勃頻率減少':null, ss.includes('libido_down')?'性慾下降':null].filter(Boolean).join('、')}）在文獻中是游離睪固酮水平下滑的早期主觀指標，與上述代謝數字的組合互相印證。`;
        }
        html+=`</p><p>ageLOC R2 的 Nrf2 路徑介入，配合 ageLOC Meta 的三重多酚機制（腸道菌路徑 × 產熱代謝 × 脂肪動員），針對此迴路的多個節點同時切入。Meta 的兒茶素 COMT 抑制機制需要有運動刺激作為基礎——每週 3 次以上 Zone 2 有氧（維持對話不喘的強度）是讓這個成分充分發揮的前提條件。</p>`;
        return html;
      }
    };

    // ── PLANS ──
    const plans = {
      mito:{
        pp:'粒線體能量維度 · 觀察訊號最強',
        p1t:'建立 Nrf2 與粒線體基礎', p1i:[
          'ageLOC R2 日錠（早餐後）：啟動 Nrf2 路徑，上調 SOD / GSH 等內源性抗氧化酵素',
