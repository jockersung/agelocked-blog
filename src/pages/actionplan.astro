---
// src/pages/action-plan.astro
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = '個人化 90 天保健參考方案 · AGELOCKED';
const description = '輸入你的健康數字，對照科學文獻，整理出適合你的 90 天 ageLOC 保健參考順序與追蹤指標。';
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      :root {
        --teal: #1a8c82; --teal-d: #116b63; --teal-p: rgba(26,140,130,0.07);
        --gold: #b8935a; --gold-p: rgba(184,147,90,0.09); --gold-mid: rgba(184,147,90,0.20);
        --ink: #111820; --body: #3a4a58;
        --border: rgba(30,70,100,0.09); --border-gold: rgba(184,147,90,0.20);
        --text: #111820; --muted: #7a8fa0; --bg: #f8f9fb; --bg-warm: #faf8f5; --bg2: #ffffff; --surface: #f0f3f7;
        --blue: #2563eb; --purple: #7c3aed;
        --orange: #c2680a; --red: #c0392b;
        --green: #1a7a50; --gold2: #92680a;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: 'Noto Serif TC', serif; background: var(--bg2); color: var(--body); }

      /* ── PAGE HEADER ── */
      .plan-header {
        padding: 3.5rem 6vw 3rem; position: relative; overflow: hidden;
        background: linear-gradient(160deg, var(--bg-warm) 60%, rgba(26,140,130,0.04));
        border-bottom: 1px solid rgba(26,140,130,0.12);
      }
      .plan-header::before {
        content: ''; position: absolute; top: -40%; right: -10%;
        width: 500px; height: 500px; pointer-events: none;
        background: radial-gradient(circle, rgba(26,140,130,0.06) 0%, transparent 70%);
      }
      .header-inner { max-width: 700px; margin: 0 auto; position: relative; }
      .brand-row {
        font-family: 'DM Mono', monospace; font-size: .6rem; letter-spacing: .4em;
        color: var(--gold); text-transform: uppercase; margin-bottom: 1.3rem;
        display: flex; align-items: center; gap: .7rem;
      }
      .brand-row::before { content: '◆'; font-size: .35rem; }
      .lock-pill {
        display: inline-flex; align-items: center; gap: .4rem;
        background: var(--gold-p); border: 1px solid var(--border-gold);
        border-radius: 2px; padding: .18rem .65rem; font-family: 'DM Mono', monospace;
        font-size: .55rem; letter-spacing: .2em; color: var(--gold); text-transform: uppercase;
        margin-bottom: 1.1rem;
      }
      .plan-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(2rem, 4.5vw, 3.2rem); font-weight: 300; line-height: 1.15;
        margin-bottom: .8rem;
      }
      .plan-title em { font-style: italic; color: var(--teal); }
      .plan-desc { font-size: .88rem; color: var(--muted); line-height: 2; font-weight: 300; max-width: 500px; }
      .progress-rail { height: 2px; background: rgba(30,70,100,0.10); margin-top: 2rem; }
      .progress-fill { height: 100%; background: linear-gradient(90deg, var(--teal), var(--teal-d)); width: 0%; transition: width .4s ease; }

      /* ── FORM WRAP ── */
      .form-wrap { max-width: 700px; margin: 0 auto; padding: 2.5rem 6vw 5rem; }

      /* Cards */
      .f-card {
        background: var(--bg2); border: 1px solid var(--border);
        border-radius: 3px; margin-bottom: 1.2rem; overflow: hidden;
        animation: fadeUp .45s ease both;
      }
      @keyframes fadeUp { from{opacity:0;transform:translateY(12px);} to{opacity:1;transform:translateY(0);} }
      .f-card:nth-child(2){animation-delay:.05s;}
      .f-card:nth-child(3){animation-delay:.10s;}
      .f-card:nth-child(4){animation-delay:.15s;}

      .f-head {
        padding: 1.1rem 1.5rem; border-bottom: 1px solid rgba(26,140,130,0.12);
        display: flex; align-items: flex-start; gap: .85rem;
      }
      .f-num {
        font-family: 'DM Mono', monospace; font-size: .55rem; letter-spacing: .2em;
        color: var(--teal); background: var(--teal-p); padding: .18rem .5rem;
        border-radius: 1px; flex-shrink: 0; margin-top: .2rem;
      }
      .f-title { font-family: 'Cormorant Garamond', serif; font-size: 1.1rem; font-weight: 400; color: var(--ink); }
      .f-sub { font-size: .72rem; color: var(--muted); font-weight: 300; margin-top: .18rem; }
      .f-body { padding: 1.3rem 1.5rem; }

      /* Fields */
      .field { margin-bottom: 1rem; }
      .field:last-child { margin-bottom: 0; }
      .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
      .row3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: .75rem; }
      label {
        display: block; font-size: .78rem; font-weight: 400;
        color: var(--ink); margin-bottom: .38rem;
      }
      .opt { font-family: 'DM Mono', monospace; font-size: .5rem; letter-spacing: .12em; color: var(--muted); background: var(--surface); padding: .06rem .35rem; border-radius: 1px; margin-left: .3rem; }
      .iw { position: relative; }
      input[type=number], input[type=text], select {
        width: 100%; background: var(--surface); border: 1px solid var(--border);
        border-radius: 2px; padding: .62rem .82rem; font-family: 'Noto Serif TC', serif;
        font-size: .85rem; color: var(--ink); transition: border-color .2s; appearance: none;
      }
      input:focus, select:focus { outline: none; border-color: var(--teal); background: var(--bg2); }
      .unit { position: absolute; right: .75rem; top: 50%; transform: translateY(-50%); font-family: 'DM Mono', monospace; font-size: .58rem; color: var(--muted); pointer-events: none; }
      select option { background: var(--bg2); }

      /* Checkboxes */
      .chk-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .42rem; }
      .chk {
        display: flex; align-items: flex-start; gap: .5rem; padding: .6rem .82rem;
        background: var(--surface); border: 1px solid var(--border); border-radius: 2px;
        cursor: pointer; font-size: .78rem; color: var(--muted); font-weight: 300;
        line-height: 1.55; transition: all .15s;
      }
      .chk:hover { border-color: var(--teal); color: var(--ink); }
      .chk.on { border-color: var(--teal); color: var(--ink); background: var(--teal-p); }
      .chk input { accent-color: var(--teal); flex-shrink: 0; margin-top: .12rem; }

      /* Generate button */
      .gen-wrap { text-align: center; margin: 1.8rem 0 0; }
      .btn-gen {
        padding: 1rem 3.2rem; background: var(--teal); color: #fff; border: none;
        border-radius: 2px; cursor: pointer; font-family: 'DM Mono', monospace;
        font-size: .75rem; letter-spacing: .2em; text-transform: uppercase; transition: all .3s;
      }
      .btn-gen:hover { background: var(--teal-d); transform: translateY(-2px); box-shadow: 0 10px 28px rgba(26,140,130,.35); }

      /* ── OUTPUT ── */
      #output { display: none; margin-top: 2rem; animation: fadeUp .6s ease both; }

      /* Output header */
      .out-header {
        background: linear-gradient(135deg, var(--bg-warm) 0%, rgba(26,140,130,0.05) 100%);
        border: 1px solid rgba(26,140,130,0.20); border-radius: 3px;
        padding: 1.8rem; margin-bottom: 1.2rem; position: relative; overflow: hidden;
      }
      .out-header::before {
        content: ''; position: absolute; top: -30%; right: -10%; width: 280px; height: 280px;
        background: radial-gradient(circle, rgba(26,140,130,.12) 0%, transparent 70%); pointer-events: none;
      }
      .out-eyebrow { font-family: 'DM Mono', monospace; font-size: .55rem; letter-spacing: .35em; color: var(--gold); text-transform: uppercase; margin-bottom: .8rem; }
      .out-title { font-family: 'Cormorant Garamond', serif; font-size: 1.55rem; font-weight: 300; color: var(--ink); line-height: 1.3; margin-bottom: .7rem; }
      .out-title em { font-style: italic; color: var(--teal); }
      .primary-pill {
        display: inline-flex; align-items: center; gap: .45rem;
        background: rgba(194,104,10,0.08); border: 1px solid rgba(194,104,10,0.20);
        border-radius: 2px; padding: .25rem .8rem;
      }
      .pp-label { font-family: 'DM Mono', monospace; font-size: .52rem; letter-spacing: .18em; color: var(--muted); text-transform: uppercase; }
      .pp-val { font-size: .82rem; color: var(--ink); font-weight: 500; }

      /* Score bars */
      .scores-block {
        background: var(--bg2); border: 1px solid var(--border); border-radius: 3px;
        padding: 1.3rem 1.5rem; margin-bottom: 1.2rem;
      }
      .block-label { font-family: 'DM Mono', monospace; font-size: .55rem; letter-spacing: .28em; color: var(--gold); text-transform: uppercase; margin-bottom: 1rem; }
      .s-row { margin-bottom: .85rem; }
      .s-row:last-of-type { margin-bottom: 0; }
      .s-meta { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: .32rem; }
      .s-name { font-size: .8rem; color: var(--ink); }
      .s-val { font-family: 'DM Mono', monospace; font-size: .68rem; color: var(--muted); }
      .s-rail { height: 4px; background: var(--surface); border-radius: 3px; overflow: hidden; }
      .s-bar { height: 100%; border-radius: 3px; transition: width 1s cubic-bezier(.4,0,.2,1); }
      .scores-note { font-size: .7rem; color: var(--muted); font-weight: 300; font-weight: 300; margin-top: .9rem; line-height: 1.8; }

      /* Data comparison */
      .data-block {
        background: var(--bg2); border: 1px solid var(--border); border-radius: 3px;
        padding: 1.3rem 1.5rem; margin-bottom: 1.2rem;
      }
      .data-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .65rem; margin-top: .9rem; }
      .d-card { background: var(--bg); border: 1px solid var(--border); border-radius: 2px; padding: .95rem 1rem; }
      .d-source { font-family: 'DM Mono', monospace; font-size: .52rem; letter-spacing: .18em; color: var(--muted); text-transform: uppercase; margin-bottom: .45rem; }
      .d-reading { font-size: .78rem; color: var(--ink); font-weight: 300; line-height: 1.75; white-space: pre-line; }
      .d-badge {
        margin-top: .45rem; padding: .32rem .55rem; border-radius: 1px;
        font-size: .7rem; font-weight: 300; line-height: 1.6;
      }
      .badge-ok  { background: rgba(26,122,80,0.08); color: #1a7a50; }
      .badge-warn{ background: rgba(194,104,10,0.08); color: var(--orange); }
      .badge-red { background: rgba(192,57,43,0.08); color: var(--red); }

      /* Analysis block */
      .analysis-block {
        background: var(--bg); border: 1px solid var(--border); border-left: 3px solid var(--teal);
        border-radius: 3px; padding: 1.3rem 1.5rem; margin-bottom: 1.2rem;
      }
      .analysis-label { font-family: 'DM Mono', monospace; font-size: .55rem; letter-spacing: .28em; color: var(--teal); text-transform: uppercase; margin-bottom: .9rem; }
      .analysis-body { font-size: .85rem; color: var(--body); line-height: 2.1; font-weight: 300; }
      .analysis-body strong { color: var(--ink); font-weight: 500; }
      .analysis-body p { margin-bottom: .9rem; }
      .analysis-body p:last-child { margin-bottom: 0; }

      /* Timeline */
      .tl-block { margin-bottom: 1.2rem; }
      .tl-label { font-family: 'DM Mono', monospace; font-size: .55rem; letter-spacing: .28em; color: var(--teal); text-transform: uppercase; margin-bottom: 1rem; }
      .tl-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .75rem; }
      .tl-card {
        background: var(--bg2); border: 1px solid var(--border); border-radius: 3px;
        padding: 1.2rem 1.1rem; position: relative; overflow: hidden;
      }
      .tl-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2.5px; }
      .tl-m1::before { background: var(--teal); }
      .tl-m2::before { background: var(--blue); }
      .tl-m3::before { background: var(--purple); }
      .tl-month { font-family: 'DM Mono', monospace; font-size: .54rem; letter-spacing: .22em; color: var(--muted); text-transform: uppercase; margin-bottom: .55rem; }
      .tl-phase { font-family: 'Cormorant Garamond', serif; font-size: .95rem; font-weight: 400; color: var(--ink); margin-bottom: .75rem; line-height: 1.3; }
      .tl-items { display: flex; flex-direction: column; gap: .38rem; }
      .tl-item { font-size: .75rem; color: var(--body); font-weight: 300; line-height: 1.65; display: flex; gap: .45rem; align-items: flex-start; }
      .tl-dot { width: 4px; height: 4px; border-radius: 50%; flex-shrink: 0; margin-top: .5rem; }
      .tl-m1 .tl-dot { background: var(--teal); }
      .tl-m2 .tl-dot { background: var(--blue); }
      .tl-m3 .tl-dot { background: var(--purple); }
      .tl-note { font-size: .68rem; color: var(--muted); font-weight: 300; margin-top: .85rem; line-height: 1.8; }

      /* 30-day tracking */
      .track-block {
        background: var(--bg2); border: 1px solid var(--border); border-radius: 3px;
        padding: 1.3rem 1.5rem; margin-bottom: 1.2rem;
      }
      .track-label { font-family: 'DM Mono', monospace; font-size: .55rem; letter-spacing: .28em; color: var(--gold2); text-transform: uppercase; margin-bottom: 1rem; }
      .track-intro { font-size: .78rem; color: var(--muted); font-weight: 300; line-height: 1.85; margin-bottom: 1rem; }
      .track-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .65rem; }
      .track-card {
        background: var(--surface); border: 1px solid var(--border); border-radius: 2px;
        padding: .95rem 1rem;
      }
      .track-metric { font-size: .82rem; font-weight: 400; color: var(--ink); margin-bottom: .28rem; }
      .track-target { font-family: 'DM Mono', monospace; font-size: .62rem; color: var(--teal); margin-bottom: .32rem; letter-spacing: .05em; }
      .track-how { font-size: .72rem; color: var(--body); font-weight: 300; line-height: 1.75; }

      /* CTA */
      .cta-block {
        background: var(--bg2); border: 1px solid rgba(26,140,130,0.20); border-radius: 3px;
        padding: 1.8rem; text-align: center; margin-bottom: 1.2rem;
      }
      .cta-title { font-family: 'Cormorant Garamond', serif; font-size: 1.25rem; font-weight: 300; color: var(--ink); margin-bottom: .45rem; }
      .cta-sub { font-size: .78rem; color: var(--muted); font-weight: 300; line-height: 1.9; margin-bottom: 1.2rem; }
      .btn-line {
        display: inline-block; padding: .85rem 2.2rem; background: var(--teal); color: #fff;
        font-family: 'DM Mono', monospace; font-size: .68rem; letter-spacing: .18em;
        text-transform: uppercase; border-radius: 2px; text-decoration: none; transition: all .3s;
      }
      .btn-line:hover { background: var(--teal-d); transform: translateY(-2px); }

      /* Legal */
      .legal-note {
        background: var(--surface); border: 1px solid var(--border); border-radius: 2px;
        padding: .95rem 1.2rem; text-align: center;
        font-size: .68rem; color: var(--muted); font-weight: 300; line-height: 1.9;
      }

      /* Responsive */
      @media (max-width: 640px) {
        .row2, .row3 { grid-template-columns: 1fr; }
        .chk-grid { grid-template-columns: 1fr; }
        .tl-grid { grid-template-columns: 1fr; }
        .data-grid { grid-template-columns: 1fr; }
        .track-grid { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <Header />

    <div class="plan-header">
      <div class="header-inner">
        <div class="brand-row">AGELOCKED · 孫義坤</div>
        <div class="lock-pill">🔒 LINE 限定 · 諮詢後專屬</div>
        <h1 class="plan-title">個人化 90 天<br><em>保健參考方案</em></h1>
        <p class="plan-desc">輸入你的健康數字，自動對照科學文獻，整理出你的數字觀察維度與 90 天 ageLOC 保健參考順序。</p>
        <div class="progress-rail"><div class="progress-fill" id="progressFill"></div></div>
      </div>
    </div>

    <div class="form-wrap">

      <!-- 01 血脂體態 -->
      <div class="f-card">
        <div class="f-head">
          <div class="f-num">01</div>
          <div>
            <div class="f-title">血脂與體態數據</div>
            <div class="f-sub">健檢報告上都有 · 沒有的欄位跳過</div>
          </div>
        </div>
        <div class="f-body">
          <div class="row3">
            <div class="field">
              <label>三酸甘油酯 TG</label>
              <div class="iw"><input type="number" id="tg" placeholder="150" oninput="prog()" /><span class="unit">mg/dL</span></div>
            </div>
            <div class="field">
              <label>高密度脂蛋白 HDL</label>
              <div class="iw"><input type="number" id="hdl" placeholder="50" oninput="prog()" /><span class="unit">mg/dL</span></div>
            </div>
            <div class="field">
              <label>腰圍</label>
              <div class="iw"><input type="number" id="waist" placeholder="88" oninput="prog()" /><span class="unit">cm</span></div>
            </div>
          </div>
          <div class="row2">
            <div class="field">
              <label>空腹血糖 <span class="opt">選填</span></label>
              <div class="iw"><input type="number" id="glucose" placeholder="95" oninput="prog()" /><span class="unit">mg/dL</span></div>
            </div>
            <div class="field">
              <label>Prysm iO 掃描分數 <span class="opt">選填</span></label>
              <div class="iw"><input type="number" id="prysm" placeholder="30000" oninput="prog()" /><span class="unit">SkinScore</span></div>
            </div>
          </div>
        </div>
      </div>

      <!-- 02 手錶數據 -->
      <div class="f-card">
        <div class="f-head">
          <div class="f-num">02</div>
          <div>
            <div class="f-title">穿戴裝置數據</div>
            <div class="f-sub">Apple Watch / Garmin / Oura — 過去一個月平均值</div>
          </div>
        </div>
        <div class="f-body">
          <div class="row2">
            <div class="field">
              <label>靜止心率 RHR</label>
              <div class="iw"><input type="number" id="rhr" placeholder="64" oninput="prog()" /><span class="unit">bpm</span></div>
            </div>
            <div class="field">
              <label>心率變異度 HRV</label>
              <div class="iw"><input type="number" id="hrv" placeholder="38" oninput="prog()" /><span class="unit">ms</span></div>
            </div>
          </div>
          <div class="row2">
            <div class="field">
              <label>RHR 近期趨勢</label>
              <select id="rhr_trend" onchange="prog()">
                <option value="">請選擇</option>
                <option value="up">緩步上升（近一個月）</option>
                <option value="stable">穩定</option>
                <option value="down">有在改善</option>
              </select>
            </div>
            <div class="field">
              <label>深睡比例 <span class="opt">選填</span></label>
              <div class="iw"><input type="number" id="deepsleep" placeholder="15" oninput="prog()" /><span class="unit">%</span></div>
            </div>
          </div>
        </div>
      </div>

      <!-- 03 症狀 -->
      <div class="f-card">
        <div class="f-head">
          <div class="f-num">03</div>
          <div>
            <div class="f-title">身體訊號</div>
            <div class="f-sub">勾選近 3 個月持續有感覺的</div>
          </div>
        </div>
        <div class="f-body">
          <div class="chk-grid" id="symGrid">
            <label class="chk"><input type="checkbox" value="fatigue_pm"    onchange="tog(this);prog()" />下午疲勞、昏沉</label>
            <label class="chk"><input type="checkbox" value="sleep_tired"   onchange="tog(this);prog()" />睡夠了還是很累</label>
            <label class="chk"><input type="checkbox" value="brain_fog"     onchange="tog(this);prog()" />腦霧、思緒不清晰</label>
            <label class="chk"><input type="checkbox" value="recovery_slow" onchange="tog(this);prog()" />運動後恢復變慢</label>
            <label class="chk"><input type="checkbox" value="belly_up"      onchange="tog(this);prog()" />腹部脂肪明顯增加</label>
            <label class="chk"><input type="checkbox" value="libido_down"   onchange="tog(this);prog()" />性慾明顯下降</label>
            <label class="chk"><input type="checkbox" value="morning_erect" onchange="tog(this);prog()" />晨勃頻率減少</label>
            <label class="chk"><input type="checkbox" value="stress_high"   onchange="tog(this);prog()" />壓力大、難放鬆</label>
            <label class="chk"><input type="checkbox" value="sleep_poor"    onchange="tog(this);prog()" />睡眠淺、容易醒</label>
            <label class="chk"><input type="checkbox" value="muscle_loss"   onchange="tog(this);prog()" />肌肉量感覺下降</label>
          </div>
        </div>
      </div>

      <div class="gen-wrap">
        <button class="btn-gen" onclick="generate()">▶ 產生我的 90 天保健參考方案</button>
      </div>

      <!-- ── OUTPUT ── -->
      <div id="output">

        <!-- Header -->
        <div class="out-header">
          <div class="out-eyebrow">◆ 文獻對照結果</div>
          <div class="out-title">你的數字，<em>主要觀察維度</em></div>
          <div class="primary-pill">
            <span class="pp-label">主要維度</span>
            <span class="pp-val" id="ppText"></span>
          </div>
        </div>

        <!-- Score bars -->
        <div class="scores-block">
          <div class="block-label">◆ 三維度文獻觀察評分</div>
          <div class="s-row">
            <div class="s-meta"><span class="s-name">粒線體能量維度</span><span class="s-val" id="sA">—</span></div>
            <div class="s-rail"><div class="s-bar" id="bA" style="background:var(--teal);width:0%"></div></div>
          </div>
          <div class="s-row">
