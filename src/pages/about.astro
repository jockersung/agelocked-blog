---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import profileImg from './profile.webp';

const title = '關於孫義坤｜用科學數據幫你找出慢性發炎根本原因的生醫顧問';
const description = '過去15年我在醫療體系負責幫醫師從海量數據中整理患者生病原因。現在，我用這套研究邏輯，幫把健康排最後的你找回被慢性發炎偷走的體力。';
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead title={title} description={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=DM+Mono:wght@300;400&family=Noto+Serif+TC:wght@300;400;500&display=swap" rel="stylesheet" />
    <style>
      :root {
        --teal:      #1a8c82;
        --teal-dark: #116b63;
        --teal-pale: rgba(26,140,130,0.07);
        --gold:      #b8935a;
        --gold-pale: rgba(184,147,90,0.09);
        --gold-mid:  rgba(184,147,90,0.20);
        --ink:       #111820;
        --body:      #3a4a58;
        --muted:     #7a8fa0;
        --border:    rgba(30,70,100,0.09);
        --border-gold: rgba(184,147,90,0.20);
        --bg:        #f8f9fb;
        --bg-warm:   #faf8f5;
        --bg2:       #ffffff;
        --surface:   #f0f3f7;
      }

      * { box-sizing: border-box; }
      body { font-family: 'Noto Serif TC', serif; color: var(--body); background: var(--bg2); }

      /* ── HERO ── */
      .about-hero {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6vw;
        align-items: center;
        padding: 7rem 6vw 5rem;
        background: var(--bg2);
        position: relative;
        overflow: hidden;
      }
      .about-hero::before {
        content: '';
        position: absolute;
        inset: 0; pointer-events: none;
        background: radial-gradient(ellipse 50% 60% at 85% 30%, rgba(26,140,130,0.06) 0%, transparent 65%),
                    radial-gradient(ellipse 30% 40% at 5% 80%, rgba(184,147,90,0.05) 0%, transparent 60%);
      }
      .hero-eyebrow {
        font-family: 'DM Mono', monospace;
        font-size: 0.66rem; letter-spacing: 0.4em;
        color: var(--gold); text-transform: uppercase;
        display: flex; align-items: center; gap: 0.8rem;
        margin-bottom: 1.6rem;
      }
      .hero-eyebrow::before { content: ''; width: 22px; height: 1px; background: var(--gold); }
      .about-name {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(2.8rem, 5vw, 4.2rem);
        font-weight: 300; line-height: 1.1; color: var(--ink);
        margin: 0 0 0.5rem;
      }
      .about-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.25rem; font-weight: 300; font-style: italic;
        color: var(--teal); margin-bottom: 1.8rem;
      }
      .hero-divider { width: 36px; height: 1.5px; background: var(--gold); margin-bottom: 1.8rem; }
      .about-tagline {
        font-size: 1.05rem;
        font-weight: 300; color: var(--body);
        line-height: 2; max-width: 420px;
      }
      .about-tagline strong { color: var(--ink); font-weight: 500; }

      /* 照片側 */
      .about-photo-wrap { position: relative; }
      .about-photo {
        width: 100%; max-width: 340px;
        aspect-ratio: 1; object-fit: cover; object-position: center top;
        border-radius: 2px;
        border: 1px solid var(--border-gold);
        box-shadow: 8px 8px 0 var(--gold-pale);
        display: block;
        margin-left: auto;
      }
      .about-credentials {
        margin-top: 1.8rem;
        display: flex; flex-direction: column; gap: 0.5rem;
      }
      .credential {
        font-family: 'DM Mono', monospace;
        font-size: 0.7rem; letter-spacing: 0.13em; color: var(--muted);
        display: flex; align-items: center; gap: 0.7rem;
      }
      .credential::before { content: '◆'; font-size: 0.38rem; color: var(--teal); }

      /* ── STORY SECTION ── */
      .story-wrap { max-width: 760px; margin: 0 auto; padding: 6rem 6vw; }

      .section-label {
        font-family: 'DM Mono', monospace;
        font-size: 0.65rem; letter-spacing: 0.4em;
        color: var(--teal); text-transform: uppercase;
        display: flex; align-items: center; gap: 0.8rem;
        margin-bottom: 1.4rem;
      }
      .section-label::before { content: '◆'; font-size: 0.38rem; }

      .section-label-gold {
        font-family: 'DM Mono', monospace;
        font-size: 0.65rem; letter-spacing: 0.4em;
        color: var(--gold); text-transform: uppercase;
        display: flex; align-items: center; gap: 0.8rem;
        margin-bottom: 1.4rem;
      }
      .section-label-gold::before { content: '◆'; font-size: 0.38rem; }

      .section-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(1.8rem, 3vw, 2.6rem);
        font-weight: 300; line-height: 1.25; color: var(--ink);
        margin: 0 0 1.4rem;
      }
      .section-title em { font-style: italic; color: var(--teal); }

      .body-text {
        font-size: 0.97rem; color: var(--body);
        line-height: 2.2; font-weight: 300; margin-bottom: 1.2rem;
      }
      .body-text:last-child { margin-bottom: 0; }
      .body-text strong { color: var(--ink); font-weight: 500; }

      .divider { border: none; border-top: 1px solid var(--border); margin: 4rem 0; }

      /* 引用塊 */
      .pullquote {
        border-left: 3px solid var(--gold);
        padding: 1.4rem 2rem;
        background: var(--gold-pale);
        margin: 2.4rem 0;
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.25rem; font-style: italic;
        color: var(--ink); line-height: 1.75;
      }

      /* 觀察清單 */
      .observe-list { display: flex; flex-direction: column; gap: 0.7rem; margin: 2rem 0; }
      .observe-item {
        display: flex; gap: 1rem;
        padding: 1rem 1.4rem;
        background: var(--bg);
        border: 1px solid var(--border);
        border-left: 2.5px solid var(--teal);
        font-size: 0.91rem; color: var(--body);
        font-weight: 300; line-height: 1.75;
        border-radius: 0 2px 2px 0;
      }
      .observe-item strong { color: var(--ink); font-weight: 500; }

      /* 方式比較 */
      .approach-compare {
        display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: 2rem 0;
      }
      .approach-card {
        padding: 1.6rem 1.8rem; background: var(--bg); border: 1px solid var(--border);
        border-radius: 2px; font-size: 0.88rem; font-weight: 300;
        color: var(--body); line-height: 1.9;
      }
      .approach-card.mine {
        background: var(--teal-pale); border-color: var(--teal); border-top: 2.5px solid var(--teal);
      }
      .approach-card-label {
        font-family: 'DM Mono', monospace; font-size: 0.62rem; letter-spacing: 0.25em;
        color: var(--muted); text-transform: uppercase; margin-bottom: 0.6rem;
      }
      .approach-card.mine .approach-card-label { color: var(--teal); }
      .approach-card-title {
        font-family: 'Cormorant Garamond', serif; font-size: 1.2rem; font-weight: 400; color: var(--ink);
        margin-bottom: 0.7rem;
      }

      /* 主題格 */
      .topics-section { padding: 5rem 6vw; background: var(--bg-warm); }
      .topics-inner { max-width: 760px; margin: 0 auto; }
      .topics-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-top: 2rem; }
      .topic {
        padding: 1.4rem 1.6rem; background: var(--bg2); border: 1px solid var(--border);
        border-radius: 2px; font-size: 0.88rem; color: var(--body);
        font-weight: 300; line-height: 1.75; transition: border-color 0.2s, background 0.2s;
      }
      .topic:hover { border-color: var(--teal); background: var(--teal-pale); }
      .topic strong {
        display: block; color: var(--ink); font-weight: 400; margin-bottom: 0.3rem;
        font-family: 'Cormorant Garamond', serif; font-size: 1.1rem;
      }

      /* CTA 區 */
      .contact-section {
        padding: 6rem 6vw; background: var(--ink); text-align: center; position: relative; overflow: hidden;
      }
      .contact-section::before {
        content: ''; position: absolute; inset: 0; pointer-events: none;
        background: radial-gradient(ellipse 55% 55% at 50% 50%, rgba(26,140,130,0.14) 0%, transparent 70%);
      }
      .contact-inner { position: relative; z-index: 1; max-width: 560px; margin: 0 auto; }
      .contact-label {
        font-family: 'DM Mono', monospace; font-size: 0.65rem;
        letter-spacing: 0.4em; color: var(--gold); text-transform: uppercase; margin-bottom: 1.6rem;
      }
      .contact-title {
        font-family: 'Cormorant Garamond', serif; font-size: clamp(2rem, 4vw, 3.2rem); font-weight: 300;
        line-height: 1.2; color: #fff; margin-bottom: 1.2rem;
      }
      .contact-title em { font-style: italic; color: #6de8df; }
      .contact-sub {
        font-size: 0.95rem; color: rgba(255,255,255,0.5); line-height: 2.1; font-weight: 300; margin-bottom: 2.8rem;
      }
      .contact-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
      .btn-teal {
        padding: 1rem 2.6rem; background: var(--teal); color: #fff;
        font-family: 'DM Mono', monospace; font-size: 0.75rem; letter-spacing: 0.2em;
        text-transform: uppercase; border-radius: 2px; text-decoration: none; transition: all 0.3s; display: inline-block;
      }
      .btn-teal:hover { background: var(--teal-dark); transform: translateY(-2px); box-shadow: 0 12px 32px rgba(26,140,130,0.35); color: #fff; }
      .btn-outline {
        padding: 1rem 2.2rem; background: transparent; color: rgba(255,255,255,0.72); border: 1px solid rgba(255,255,255,0.22);
        font-family: 'DM Mono', monospace; font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; border-radius: 2px; text-decoration: none; transition: all 0.3s; display: inline-flex; align-items: center; gap: 0.5rem;
      }
      .btn-outline:hover { border-color: rgba(255,255,255,0.55); color: #fff; }
      .contact-note { margin-top: 1.8rem; font-family: 'DM Mono', monospace; font-size: 0.62rem; letter-spacing: 0.2em; color: rgba(255,255,255,0.28); }

      /* ── Responsive ── */
      @media (max-width: 760px) {
        .about-hero { grid-template-columns: 1fr; padding: 5rem 5vw 4rem; }
        .about-photo { max-width: 220px; margin: 0 auto; }
        .approach-compare { grid-template-columns: 1fr; }
        .topics-grid { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <Header />

    <section class="about-hero">
      <div>
        <div class="hero-eyebrow">高階健康專案經理</div>
        <h1 class="about-name">孫義坤</h1>
        <div class="about-title">用科學數據幫你「除錯」的生醫專員</div>
        <div class="hero-divider"></div>
        <p class="about-tagline">
          過去 15 年，我在醫療體系負責幫醫師從海量數據中整理患者的生病原因，並發表成國際論文。<br><br>
          現在，我用這套研究邏輯，幫把健康排最後的你用科學數據<strong>『除錯』</strong>，找回被慢性發炎偷走的體力。
        </p>
      </div>
      <div class="about-photo-wrap">
        <Image src={profileImg} alt="孫義坤" class="about-photo" width={340} height={340} />
        <div class="about-credentials">
          <span class="credential">陽明交通大學 應用化學系</span>
          <span class="credential">清華大學 分子醫學研究所</span>
          <span class="credential">醫療體系研究工作 15 年</span>
          <span class="credential">抗衰老生物技術研究應用</span>
        </div>
      </div>
    </section>

    <div class="story-wrap">

      <div class="section-label">指出產業亂象</div>
      <h2 class="section-title">
        我發現把健康排最後的人，很常忽視健康<br>
        <em>結果就是頭痛醫頭腳痛醫腳</em>
      </h2>

      <p class="body-text">
        我發現醫療體系跟一般大眾之間有道牆：病患在診間只有幾分鐘，醫師能給你的只是簡單的結論或藥物；而市面上的保健品廣告又吹得太神。結果，把健康排最後的這群人，只能用最沒有效率的方式管理健康。
      </p>
      
      <div class="approach-compare">
        <div class="approach-card">
          <div class="approach-card-label">一般做法</div>
          <div class="approach-card-title">症狀 → 對應產品</div>
          感冒不好就多休息。嘴破就說補B群。
          眼睛乾就點眼藥水。每個症狀一個答案——
          你買了一堆，症狀還是一直輪流出現。
        </div>
        <div class="approach-card mine">
          <div class="approach-card-label">我的做法</div>
          <div class="approach-card-title">連起來看，找出系統 Bug</div>
          用醫療研究邏輯，幫你整理這些症狀背後的共同模式。找到讓「慢性發炎」在你身上持續的底層原因，從那裡介入，症狀才會真正好轉。
        </div>
      </div>

      <hr class="divider" />

      <div class="section-label-gold">我的專業壁壘</div>
      <h2 class="section-title">
        我不賣奇蹟，<br>
        <em>我只看科學實證與數據</em>
      </h2>

      <p class="body-text">
        在做醫學研究的這些年，我學會了如何從最嚴謹的實驗與數據中找答案。我不賣奇蹟，也不講玄學。我只提供具備數據證實、且在科學文獻上有明確證據的健康管理路徑，幫你找出體檢紅字背後的系統漏洞。
      </p>

      <hr class="divider" />

      <div class="section-label">我的使命</div>
      <h2 class="section-title">
        別在準備享受下半場時，<br>
        <em>才發現還不完的技術債</em>
      </h2>

      <p class="body-text">
        我建立 Agelocked 的初衷很簡單：希望讓這些撐起台灣產業的菁英，不需要在事業巔峰、準備享受人生下半場的時候，才發現身體早已累積了無法償還的技術債。
      </p>

      <div class="observe-list">
        <div class="observe-item">體檢紅字看了不知道怎麼辦，醫生說多休息，但你不知道從哪裡開始「除錯」。</div>
        <div class="observe-item">買過一堆保健品，但只是「頭痛醫頭」，症狀依舊輪流出現。</div>
        <div class="observe-item">工作型態短期內不會改變，需要在現有高壓條件下，找到最有效率的科學介入點。</div>
      </div>

    </div><section class="topics-section">
      <div class="topics-inner">
        <div class="section-label">這裡寫什麼</div>
        <h2 class="section-title">
          你會在這裡<br>
          <em>找到什麼</em>
        </h2>
        <p class="body-text" style="max-width:520px;">
          每篇文章都從你真實搜尋過的問題出發，
          用醫療研究的邏輯幫你看懂症狀背後的原因，
          而不是單純給你一個產品建議。
        </p>
        <div class="topics-grid">
          <div class="topic">
            <strong>免疫與慢性發炎</strong>
            感冒一直不好、嘴破反覆——為什麼頭痛醫頭永遠解決不了
          </div>
          <div class="topic">
            <strong>細胞修復與粒線體</strong>
            從細胞層級理解為什麼你的身體修復速度跟不上損耗
          </div>
          <div class="topic">
            <strong>體檢報告解讀</strong>
            紅字背後真正代表什麼，以及你能做什麼
          </div>
          <div class="topic">
            <strong>抗氧化與補充方向</strong>
            什麼真的有用、什麼只是你以為有用
          </div>
        </div>
      </div>
    </section>

    <section class="contact-section">
      <div class="contact-inner">
        <div class="contact-label">下一步行動</div>
        <h2 class="contact-title">
          停止一個個追症狀，<br>
          <em>先找出共同的根本原因</em>
        </h2>
        <p class="contact-sub">
          如果你也厭倦了無效的補充與不斷輪流出現的小毛病，<br>
          歡迎直接私訊我你手邊那份讓你無解的體檢報告，<br>
          或者索取【抗發炎自我檢測清單】。
        </p>
        <div class="contact-btns">
          <a href="https://line.me/ti/p/@fer7932k" target="_blank" class="btn-teal">
            💬 加 LINE 索取檢測清單
          </a>
          <a href="mailto:sunyikun0729@gmail.com" class="btn-outline">
            📧 用 Email 聯絡我
          </a>
        </div>
        <div class="contact-note">不推銷產品 · 先用數據搞清楚你的狀況再說</div>
      </div>
    </section>

    <Footer />
  </body>
</html>