---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import ShareButtons from '../components/ShareButtons.astro';
import TableOfContents from '../components/TableOfContents.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: MarkdownHeading[];
	relatedPosts?: CollectionEntry<'blog'>[];
};

const { title, description, pubDate, updatedDate, heroImage, headings = [], relatedPosts = [], ctaType = 'soft', ctaBridge = '', faq = [] } = Astro.props;

// CTA 文字設定
const isSoft = ctaType !== 'hard';

const defaultBridge = isSoft
  ? '如果你最近也有類似的情況，建議先做一個系統化的評估，看看你的身體警報目前在哪個水位。'
  : '如果你手上已經有健檢數據或穿戴裝置數據，下一步比繼續看文章更有效的是先把資料整理起來。';

const bridge = ctaBridge || defaultBridge;
---
<!DOCTYPE html>
<html lang="zh-TW">
	<head>
		<BaseHead title={title} description={description} />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Article",
			"headline": title,
			"description": description,
			"datePublished": pubDate.toISOString(),
			"dateModified": (updatedDate ?? pubDate).toISOString(),
			"image": heroImage ? `https://agelocked.com${heroImage}` : "https://agelocked.com/og-default.jpg",
			"author": {
				"@type": "Person",
				"name": "YiKun",
				"url": "https://agelocked.com"
			},
			"publisher": {
				"@type": "Organization",
				"name": "AGELOCKED",
				"url": "https://agelocked.com",
				"logo": {
					"@type": "ImageObject",
					"url": "https://agelocked.com/favicon.svg"
				}
			},
			"mainEntityOfPage": {
				"@type": "WebPage",
				"@id": Astro.url.href
			}
		})} />
	{faq.length > 0 && (
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "FAQPage",
			"mainEntity": faq.map((item: { question: string; answer: string }) => ({
				"@type": "Question",
				"name": item.question,
				"acceptedAnswer": {
					"@type": "Answer",
					"text": item.answer
				}
			}))
		})} />
	)}
	</head>
	<body>
		<ReadingProgress />
		<Header />
		<main>
			<div class="hero-image">
				{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
			</div>
			<div class="post-layout">
				<article>
					<div class="prose">
						<div class="title">
							<div class="date">
								<FormattedDate date={pubDate} />
								{updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)}
							</div>
							<h1>{title}</h1>
							<hr />
						</div>
						{headings.length > 0 && (
							<div class="toc-inline">
								<TableOfContents headings={headings} />
							</div>
						)}
						<slot />

						<!-- ===== ARTICLE CTA ===== -->
						<div class={`article-cta article-cta--${ctaType}`}>
							<div class="article-cta__inner">
								<span class="article-cta__eyebrow">下一步</span>
								{isSoft ? (
									<>
										<h3 class="article-cta__title">先不要急著補，先看你現在屬於哪一型</h3>
										<p class="article-cta__bridge">{bridge}</p>
										<a href="/assessment" class="article-cta__btn">
											⚡ 花 1 分鐘做身體警報風險評估
										</a>
										<p class="article-cta__note">
											評估結果是第一步。完成後，把結果和你的健檢數據一起帶進來，才能看出真正的方向。
										</p>
										<div class="article-cta__secondary">
											已有健檢數據？<a href="/prescan">直接填寫資料表 →</a>
										</div>
									</>
								) : (
									<>
										<h3 class="article-cta__title">不要再盲測，先把現有數據整理起來</h3>
										<p class="article-cta__bridge">{bridge}</p>
										<a href="/prescan" class="article-cta__btn">
											📊 填寫資料表，整理你的下一步方向
										</a>
										<p class="article-cta__note">
											完成後我會協助你先整理目前最值得優先處理的項目與順序。
										</p>
										<div class="article-cta__secondary">
											還沒做過評估？<a href="/assessment">先做 1 分鐘身體警報評估 →</a>
										</div>
									</>
								)}
							</div>
						</div>
						<!-- ===== /ARTICLE CTA ===== -->

						<RelatedPosts posts={relatedPosts} />
						<ShareButtons title={title} url={Astro.url.href} />
					</div>
				</article>
				{headings.length > 0 && (
					<aside class="toc-sidebar">
						<TableOfContents headings={headings} />
					</aside>
				)}
			</div>
		</main>
		<Footer />

		<script is:inline>
			// 把 CTA 移到「參考資料」標題之前
			// 若無參考資料，CTA 留在原位（文章最後）
			(function () {
				const cta = document.querySelector('.article-cta');
				if (!cta) return;

				// 找 h2 文字包含「參考資料」的節點
				const headings = document.querySelectorAll('h2');
				let refHeading = null;
				for (const h of headings) {
					if (h.textContent.trim().includes('參考資料')) {
						refHeading = h;
						break;
					}
				}

				if (refHeading) {
					// 插到參考資料 h2 之前
					refHeading.parentNode.insertBefore(cta, refHeading);
				}
				// 沒有參考資料 → cta 已在文章末，不動
			})();
		</script>
	</body>
</html>

<style>
	main {
		width: calc(100% - 2em);
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1em;
	}

	.hero-image {
		width: 100%;
		max-width: 1020px;
		margin: 0 auto 2rem;
	}

	.hero-image img {
		display: block;
		margin: 0 auto;
		border-radius: 12px;
		box-shadow: var(--box-shadow);
	}

	.post-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 280px;
		gap: 3rem;
		align-items: start;
	}

	.prose {
		width: 720px;
		max-width: 100%;
		margin: auto;
		padding: 1em;
		overflow-wrap: break-word;
		word-break: break-word;
	}

	.title {
		margin-bottom: 1em;
		padding: 1em 0;
		text-align: center;
		line-height: 1;
	}

	.title h1 {
		margin: 0 0 0.5em 0;
		font-size: clamp(1.6rem, 3vw, 2.4rem);
	}

	.date {
		margin-bottom: 0.5em;
		color: var(--muted);
	}

	.last-updated-on {
		font-style: italic;
	}

	/* TOC sidebar: visible on wide screens */
	.toc-sidebar {
		position: sticky;
		top: 80px;
	}

	/* TOC inline: hidden on wide screens (shown in sidebar instead) */
	.toc-inline {
		display: none;
	}

	@media (max-width: 1100px) {
		.post-layout {
			grid-template-columns: minmax(0, 1fr);
			gap: 0;
		}

		.toc-sidebar {
			display: none;
		}

		.toc-inline {
			display: block;
			margin-bottom: 2rem;
		}
	}

	/* ===== ARTICLE CTA ===== */
	.article-cta {
		margin: 3rem 0 2rem;
		border-radius: 2px;
		overflow: hidden;
	}
	.article-cta--soft {
		background: rgba(26,140,130,0.06);
		border: 1px solid rgba(26,140,130,0.18);
		border-left: 4px solid #1a8c82;
	}
	.article-cta--hard {
		background: #111820;
		border: 1px solid rgba(255,255,255,0.06);
		border-left: 4px solid #b8935a;
	}
	.article-cta__inner {
		padding: 2rem 2.2rem;
	}
	.article-cta__eyebrow {
		display: block;
		font-family: 'DM Mono', monospace;
		font-size: 0.65rem;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		margin-bottom: 0.6rem;
	}
	.article-cta--soft .article-cta__eyebrow { color: #1a8c82; }
	.article-cta--hard .article-cta__eyebrow { color: #b8935a; }

	.article-cta__title {
		font-family: 'Cormorant Garamond', serif;
		font-size: clamp(1.25rem, 2.5vw, 1.6rem);
		font-weight: 300;
		line-height: 1.3;
		margin: 0 0 1rem 0;
	}
	.article-cta--soft .article-cta__title { color: #111820; }
	.article-cta--hard .article-cta__title { color: #ffffff; }

	.article-cta__bridge {
		font-size: 0.92rem;
		line-height: 1.9;
		font-weight: 300;
		margin: 0 0 1.4rem 0;
	}
	.article-cta--soft .article-cta__bridge { color: #3a4a58; }
	.article-cta--hard .article-cta__bridge { color: rgba(255,255,255,0.65); }

	.article-cta__btn {
		display: inline-block;
		padding: 0.9rem 1.8rem;
		border-radius: 2px;
		text-decoration: none;
		font-family: 'DM Mono', monospace;
		font-size: 0.8rem;
		letter-spacing: 0.12em;
		background: #1a8c82;
		color: #ffffff;
		transition: all 0.25s;
		margin-bottom: 1.1rem;
	}
	.article-cta__btn:hover {
		background: #116b63;
		transform: translateY(-2px);
		box-shadow: 0 8px 20px rgba(26,140,130,0.28);
	}
	.article-cta--hard .article-cta__btn {
		background: #b8935a;
	}
	.article-cta--hard .article-cta__btn:hover {
		background: #9a7848;
		box-shadow: 0 8px 20px rgba(184,147,90,0.28);
	}

	.article-cta__note {
		font-size: 0.8rem;
		line-height: 1.85;
		font-weight: 300;
		margin: 0 0 1.1rem 0;
	}
	.article-cta--soft .article-cta__note { color: #7a8fa0; }
	.article-cta--hard .article-cta__note { color: rgba(255,255,255,0.38); }

	.article-cta__secondary {
		font-family: 'DM Mono', monospace;
		font-size: 0.65rem;
		letter-spacing: 0.06em;
		padding-top: 1rem;
		border-top: 1px solid;
	}
	.article-cta--soft .article-cta__secondary {
		color: #7a8fa0;
		border-color: rgba(26,140,130,0.15);
	}
	.article-cta--hard .article-cta__secondary {
		color: rgba(255,255,255,0.28);
		border-color: rgba(255,255,255,0.08);
	}
	.article-cta__secondary a {
		margin-left: 0.4rem;
		text-decoration: none;
	}
	.article-cta--soft .article-cta__secondary a { color: #1a8c82; }
	.article-cta--hard .article-cta__secondary a { color: rgba(255,255,255,0.5); }
	.article-cta__secondary a:hover { text-decoration: underline; }

	@media (max-width: 640px) {
		.article-cta__inner { padding: 1.5rem 1.2rem; }
		.article-cta__btn { display: block; text-align: center; }
	}
	/* ===== /ARTICLE CTA ===== */
</style>
